{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.bak)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",

      "Bash(shopify theme push *)",
      "Bash(shopify theme publish *)",
      "Bash(shopify theme share *)",
      "Bash(shopify theme delete *)",
      "Bash(shopify theme rename *)",
      "Bash(shopify app deploy *)",
      "Bash(shopify app release *)",
      "Bash(shopify app config push *)",
      "Bash(npx shopify *)",
      "Bash(render *)",
      "Bash(neonctl *)",
      "Bash(neon *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(node dist/migrate.js *)",
      "Bash(npm run cancellations:retention *)",
      "Bash(node dist/cancellation-retention.js *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --delete *)",
      "Bash(git push * --mirror*)",

      "PowerShell(shopify theme push *)",
      "PowerShell(shopify theme publish *)",
      "PowerShell(shopify theme share *)",
      "PowerShell(shopify theme delete *)",
      "PowerShell(shopify theme rename *)",
      "PowerShell(shopify app deploy *)",
      "PowerShell(shopify app release *)",
      "PowerShell(shopify app config push *)",
      "PowerShell(npx shopify *)",
      "PowerShell(render *)",
      "PowerShell(neonctl *)",
      "PowerShell(neon *)",
      "PowerShell(psql *)",
      "PowerShell(pg_dump *)",
      "PowerShell(node dist/migrate.js *)",
      "PowerShell(npm run cancellations:retention *)",
      "PowerShell(node dist/cancellation-retention.js *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * --force-with-lease*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * --delete *)",
      "PowerShell(git push * --mirror*)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(Get-Content *.env *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr create *)",
      "Bash(gh api *)",
      "Bash(gh workflow run *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(shopify *)",
      "Bash(npm run dev *)",
      "Bash(npm run migrate *)",
      "Bash(npm start *)",
      "Bash(npm run inspect:catalog *)",
      "Bash(npm run stress:real-catalog *)",
      "Bash(node --env-file*)",
      "Bash(npx tsx --env-file*)",
      "Bash(curl *)",
      "Bash(wget *)",

      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch --delete *)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh api *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh release *)",
      "PowerShell(gh repo *)",
      "PowerShell(shopify *)",
      "PowerShell(npm run dev *)",
      "PowerShell(npm run migrate *)",
      "PowerShell(npm start *)",
      "PowerShell(npm run inspect:catalog *)",
      "PowerShell(npm run stress:real-catalog *)",
      "PowerShell(node --env-file*)",
      "PowerShell(npx tsx --env-file*)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl *)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(node --test tests/*)",
      "Bash(node --test --test-concurrency=1 tests/*)",
      "Bash(npx tsx --test tests/*)",
      "PowerShell(npm test)",
      "PowerShell(npm run build)",
      "PowerShell(npm run typecheck)",
      "PowerShell(node --test tests/*)",
      "PowerShell(node --test --test-concurrency=1 tests/*)",
      "PowerShell(npx tsx --test tests/*)"
    ]
  }
}
