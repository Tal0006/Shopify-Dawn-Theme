      "label": "t:storefront_editor.show_policies",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_footer_links",
      "label": "הצגת תפריטי התחתית",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "הצגת הרשמה לעדכונים",
      "default": false
    },
    {
