<footer class="footer-area storefront-footer" dir="rtl">
  <div class="container storefront-footer-inner">
    {% if section.settings.show_store_name %}<a class="storefront-footer-name" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>{% endif %}
    {% assign facebook_url = section.settings.facebook | default: settings.social_facebook_link %}
    {% assign instagram_url = section.settings.instagram | default: settings.social_instagram_link %}
    {% if section.settings.whatsapp != blank or facebook_url != blank or instagram_url != blank %}
    <ul class="storefront-footer-social" role="list" aria-label="{% if section.settings.follow_title != blank %}{{ section.settings.follow_title | escape }}{% else %}{{ 'storefront.follow' | t }}{% endif %}">
      {% if section.settings.whatsapp != blank %}<li><a href="{{ section.settings.whatsapp | escape }}" aria-label="{{ 'storefront.whatsapp' | t }}"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.1.55 4.15 1.6 5.96L0 24l6.24-1.64a11.9 11.9 0 0 0 5.8 1.48h.01c6.59 0 11.95-5.36 11.95-11.95 0-3.19-1.24-6.19-3.48-8.41ZM12.05 21.82a9.9 9.9 0 0 1-5.05-1.38l-.36-.22-3.7.97.99-3.61-.24-.37a9.88 9.88 0 0 1-1.52-5.26c0-5.48 4.46-9.94 9.95-9.94 2.65 0 5.15 1.04 7.02 2.92a9.86 9.86 0 0 1 2.91 7.03c0 5.48-4.46 9.86-10 9.86Zm5.45-7.43c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.9-.8-1.5-1.77-1.68-2.07-.17-.3-.02-.46.13-.61l.45-.52c.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.1 4.49.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.77-.73 2.02-1.44.25-.72.25-1.33.17-1.45-.07-.13-.27-.2-.57-.35Z"/></svg></a></li>{% endif %}
      {% if facebook_url != blank %}<li><a href="{{ facebook_url | escape }}" aria-label="{{ 'storefront.facebook' | t }}"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M22.68 0H1.32C.59 0 0 .59 0 1.32v21.36C0 23.41.59 24 1.32 24h11.5v-9.29H9.69v-3.62h3.13V8.41c0-3.1 1.9-4.79 4.66-4.79 1.33 0 2.47.1 2.8.14v3.24h-1.92c-1.5 0-1.79.71-1.79 1.76v2.33h3.58l-.47 3.62h-3.11V24h6.11c.73 0 1.32-.59 1.32-1.32V1.32C24 .59 23.41 0 22.68 0Z"/></svg></a></li>{% endif %}
      {% if instagram_url != blank %}<li><a href="{{ instagram_url | escape }}" aria-label="{{ 'storefront.instagram' | t }}"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.22.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.05.41 2.22.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.22-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.05.36-2.22.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.22-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.05-.41-2.22-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.22.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.05-.36 2.22-.41 1.27-.06 1.65-.07 4.85-.07ZM12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56a5.88 5.88 0 0 0-2.12 1.39A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.77.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.39 2.12a5.88 5.88 0 0 0 2.12 1.39c.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56a5.88 5.88 0 0 0 2.12-1.39 5.88 5.88 0 0 0 1.39-2.12c.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.39-2.12 5.88 5.88 0 0 0-2.12-1.39c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.41-11.84a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg></a></li>{% endif %}
    </ul>
    {% endif %}
    {% if section.settings.show_footer_links %}<div class="storefront-footer-links">
  {% if section.settings.footer_link != blank %}<nav aria-label="{{ 'sections.header.menu' | t }}"><h3>{{ 'sections.header.menu' | t }}</h3><ul>{% for link in section.settings.footer_link.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></nav>{% endif %}
  {% if section.settings.service_menu != blank %}<nav aria-label="{{ 'storefront.customer_service' | t }}"><h3>{{ 'storefront.customer_service' | t }}</h3><ul>{% for link in section.settings.service_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></nav>{% endif %}
  {% if section.settings.show_policies %}<nav aria-label="{{ 'storefront.policies' | t }}"><h3>{{ 'storefront.policies' | t }}</h3><ul>{% for policy in shop.policies %}{% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul></nav>{% endif %}
</div>{% elsif section.settings.show_policies %}
    <nav class="storefront-footer-policies" aria-label="{{ 'storefront.policies' | t }}"><ul>{% for policy in shop.policies %}{% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul></nav>
    {% endif %}
    {% if section.settings.show_footer_links and section.settings.tiktok != blank %}<a href="{{ section.settings.tiktok | escape }}">{{ 'storefront.tiktok' | t }}</a>{% endif %}
    {% if section.settings.show_newsletter %}  <div class="newslatter-area"><h4>{% if section.settings.newsletter_title != blank %}{{ section.settings.newsletter_title | escape }}{% else %}{{ 'storefront.newsletter_title' | t }}{% endif %}</h4>
    {% assign newsletter_form_id = 'FooterNewsletter-' | append: section.id %}
    {% form 'customer', id: newsletter_form_id, class: 'storefront-validated-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="FooterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
      <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required {% if form.errors %}aria-invalid="true" aria-describedby="FooterErrors-{{ section.id }}"{% endif %}>
      <button type="submit">{{ 'newsletter.button_label' | t }}</button>
      {% if form.errors %}<div class="storefront-form-errors" id="FooterErrors-{{ section.id }}">{{ form.errors | default_errors }}</div>{% endif %}
      {% if form.posted_successfully? %}<p role="status">{{ 'newsletter.success' | t }}</p>{% endif %}
    {% endform %}
  </div>{% endif %}
    {% if section.settings.show_payment_icons and shop.enabled_payment_types != blank %}<ul class="paymets" aria-label="{{ 'sections.footer.payment' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}
    {% if section.settings.show_copyright %}<p class="storefront-footer-copyright">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>{% endif %}
  </div>
</footer>
{% schema %}
{
  "name": "t:storefront_editor.footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_store_name",
      "label": "הצגת שם החנות",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "הצגת זכויות יוצרים",
      "default": true
    },
    {
      "type": "text",
      "id": "follow_title",
      "label": "t:storefront_editor.follow_title"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "t:storefront_editor.instagram"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "t:storefront_editor.facebook"
    },
    {
      "type": "url",
      "id": "whatsapp",
      "label": "t:storefront_editor.whatsapp"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "t:storefront_editor.tiktok"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "t:storefront_editor.newsletter_title"
    },
    {
      "type": "link_list",
      "id": "footer_link",
      "label": "t:storefront_editor.footer_menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "service_menu",
      "label": "t:storefront_editor.service_menu"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:storefront_editor.show_policies",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_footer_links",
      "label": "הצגת תפריטי התחתית",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "הצגת הרשמה לעדכונים",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "הצגת סמלי אמצעי תשלום",
      "default": false
    }
  ]
}
{% endschema %}
