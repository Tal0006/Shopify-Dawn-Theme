<section data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.product_limit }}&intent=related" class="catalog-section catalog-home container" {% unless recommendations.performed and recommendations.products_count > 0 %}hidden{% endunless %}>
{% if recommendations.performed and recommendations.products_count > 0 %}<header class="catalog-section-header"><h2>{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'storefront.product_recommendations' | t }}{% endif %}</h2></header><div class="catalog-grid">{% for card_product in recommendations.products %}{% render 'product-card', card_product: card_product, refined_card: true %}{% endfor %}</div>{% endif %}
</section>
{% schema %}
{
  "name": "t:sections.related-products.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:storefront_editor.heading"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:storefront_editor.product_limit",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
