{% if section.settings.enabled %}
<section class="trust-strip container" {% if section.settings.heading != blank %}aria-labelledby="TrustStripHeading-{{ section.id }}"{% else %}aria-label="{{ 'trust_strip.label' | t | escape }}"{% endif %}>
  {% if section.settings.heading != blank %}<h2 id="TrustStripHeading-{{ section.id }}" class="trust-strip__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
  <ul class="trust-strip__list" role="list">
    {% for block in section.blocks %}
      {% if block.settings.title != blank %}
        <li class="trust-strip__item" {{ block.shopify_attributes }}>
          <svg class="trust-strip__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {% case block.settings.icon %}
              {% when 'location' %}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>
              {% when 'package' %}<path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10M7 5l10 4"/>
              {% when 'shield' %}<path d="m12 2 8 3v6c0 5-8 11-8 11S4 16 4 11V5l8-3Z"/><rect x="9" y="10" width="6" height="6" rx="1"/><path d="M10 10V8a2 2 0 0 1 4 0v2"/>
              {% else %}<path d="M3 5h11v12H3V5Zm11 4h4l3 4v4h-7M3 17H2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
            {% endcase %}
          </svg>
          <div class="trust-strip__copy"><p class="trust-strip__title">{{ block.settings.title | escape }}</p>{% if block.settings.subtitle != blank %}<p class="trust-strip__subtitle">{{ block.settings.subtitle | escape }}</p>{% endif %}</div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</section>
{% endif %}
{% stylesheet %}
.trust-strip { padding-block: 18px; }
.trust-strip__heading { font-size: 20px; margin-block: 0 12px; }
.trust-strip__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 8px; list-style: none; border: 1px solid var(--storefront-border-soft, #cfdfe4); border-radius: 14px; background: var(--storefront-glass, #fffffff0); box-shadow: var(--storefront-shadow, 0 4px 18px #1b434e14); }
.trust-strip__item { display: flex; align-items: center; justify-content: center; gap: 12px; min-width: 0; padding: 16px 12px; border-inline-end: 1px solid var(--storefront-border-soft, #cfdfe4); border-radius: 8px; transition: transform 200ms var(--storefront-ease, ease), box-shadow 200ms var(--storefront-ease, ease); }
.trust-strip__item:last-child { border-inline-end: 0; }
.trust-strip__icon { flex: 0 0 28px; color: var(--storefront-accent, #086b7b); }
.trust-strip__copy { min-width: 0; }
.trust-strip__title { margin: 0; color: var(--storefront-ink, #182b25); font-size: 15px; line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; }
.trust-strip__subtitle { margin: 3px 0 0; font-size: 12px; line-height: 1.5; color: #50646a; overflow-wrap: anywhere; }
@media (hover: hover) and (pointer: fine) {
 .trust-strip__item:hover { transform: translateY(-2px); box-shadow: 0 3px 10px #0e91a512; }
}
@media (max-width: 991px) {
 .trust-strip { padding-block: 12px; }
 .trust-strip__list { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 4px; }
 .trust-strip__item { justify-content: flex-start; gap: 8px; padding: 12px 8px; }
 .trust-strip__item:nth-child(2n) { border-inline-end: 0; }
 .trust-strip__item:nth-child(n+3) { border-block-start: 1px solid var(--storefront-border-soft, #cfdfe4); }
 .trust-strip__title { font-size: 13px; }
}
@media (max-width: 599px) {
 .trust-strip__icon { flex-basis: 24px; width: 24px; height: 24px; }
 .trust-strip__subtitle { display: none; }
 .trust-strip__item { min-height: 64px; }
}
@media (prefers-reduced-motion: reduce) {
 .trust-strip__item { transition: none; }
 .trust-strip__item:hover { transform: none; }
}
html[data-a11y-paused] .trust-strip__item:hover { transform: none; }
{% endstylesheet %}
{% schema %}
{
  "name": "t:trust_strip_editor.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:trust_strip_editor.enabled",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:trust_strip_editor.heading"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "t:trust_strip_editor.benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:trust_strip_editor.title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "t:trust_strip_editor.subtitle"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:trust_strip_editor.icon",
          "default": "truck",
          "options": [
            {
              "value": "truck",
              "label": "t:trust_strip_editor.truck"
            },
            {
              "value": "location",
              "label": "t:trust_strip_editor.location"
            },
            {
              "value": "package",
              "label": "t:trust_strip_editor.package"
            },
            {
              "value": "shield",
              "label": "t:trust_strip_editor.shield"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:trust_strip_editor.name",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "t:trust_strip_editor.title_0",
            "subtitle": "t:trust_strip_editor.subtitle_0"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "location",
            "title": "t:trust_strip_editor.title_1",
            "subtitle": "t:trust_strip_editor.subtitle_1"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "package",
            "title": "t:trust_strip_editor.title_2",
            "subtitle": "t:trust_strip_editor.subtitle_2"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "t:trust_strip_editor.title_3",
            "subtitle": "t:trust_strip_editor.subtitle_3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
