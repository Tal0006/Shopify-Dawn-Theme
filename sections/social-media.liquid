<!-- social-area -->
<div class="social-area">
  <div class="title">
    <h2>{% if section.settings.title != blank %}{{ section.settings.title }}{% else %}{{ 'storefront.follow' | t }}{% endif %}</h2>
  </div>
  <div class="container">
    <div class="social-wrap">
      <div class="row s-5">
        {% if section.settings.social != blank %}
          {{ section.settings.social }}
        {% else %}
          {% for block in section.blocks %}
            <div class="col-lg-4 col-sm-6 col-12">
              {{ section.settings.social }}

              <div class="social-item">
                <a href="{{ block.settings.url | default: routes.root_url | escape }}" class="social-img" aria-label="{{ block.settings.alt_text | default: block.settings.image.alt | default: section.settings.title | default: shop.name | escape }}">
                  {% if block.settings.image != blank and block.settings.image.width != blank %}<img src="{{ block.settings.image | image_url: width: 800 }}" width="" height="" alt="{{ block.settings.image.alt | default: block.settings.alt_text | default: section.settings.title | default: shop.name | escape }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
                </a>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:storefront_editor.social",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:storefront_editor.heading"
    },
    {
      "type": "liquid",
      "id": "social",
      "label": "t:storefront_editor.text"
    }
  ],
  "blocks": [
    {
      "name": "t:storefront_editor.category",
      "type": "block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:storefront_editor.image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:storefront_editor.link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "תיאור התמונה והקישור לנגישות"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:storefront_editor.social",
      "blocks": [
        {
          "type": "block"
        }
      ]
    }
  ]
}
{% endschema %}
