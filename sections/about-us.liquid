<div class="about-area section-padding">
  <div class="container">
    <div class="about-wrap">
      <div class="title">
        <h1>{% if section.settings.title != blank %}{{ section.settings.title }}{% else %}{{ 'storefront.about' | t }}{% endif %}</h1>
      </div>
      <strong>{% if section.settings.subtitle != blank %}{{ section.settings.subtitle }}{% else %}{{ 'storefront.about_subtitle' | t }}{% endif %}</strong>
      <h2>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'storefront.about_heading' | t }}{% endif %}</h2>
      {% if section.settings.description != blank %}{{ section.settings.description }}{% else %}{{ 'storefront.about_text' | t }}{% endif %}
      <span class="shape1"><img src="{{ 'shape3.png' | asset_url }}" width="" height="" alt=""></span>
      <div class="shape2"><img src="{{ 'footer2.png' | asset_url }}" alt="" width="" height=""></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:storefront_editor.about",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:storefront_editor.heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:storefront_editor.subtitle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:storefront_editor.heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:storefront_editor.text"
    }
  ],
  "presets": [
    {
      "name": "t:storefront_editor.about"
    }
  ]
}
{% endschema %}
