<div class="about-area section-padding page-content">
  <div class="container">
    <div class="about-wrap">
      <div class="title">
        <h1>{{ page.title | escape }}</h1>
      </div>
      {{ page.content }}
      <span class="shape1"><img src="{{ 'shape3.png' | asset_url }}" class="fk-img-auto" width="88" height="89" alt="" aria-hidden="true" loading="lazy" decoding="async"></span>
      <div class="shape2"><img src="{{ 'footer2.png' | asset_url }}" class="fk-img-auto" width="126" height="88" alt="" aria-hidden="true" loading="lazy" decoding="async"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:storefront_editor.content",
  "settings": [],
  "presets": [
    {
      "name": "t:storefront_editor.content"
    }
  ]
}
{% endschema %}
