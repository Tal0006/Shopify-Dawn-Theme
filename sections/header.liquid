<header id="header" class="storefront-header">
<div class="site-header header-style-1"><nav class="navigation navbar navbar-expand-lg navbar-light"><div class="container-fluid"><div class="row">
  <a class="navbar-brand storefront-menu-logo" href="{{ routes.root_url }}">
    {% assign header_logo = section.settings.logo | default: settings.logo %}
    {% if header_logo != blank %}{{ header_logo | image_url: width: 400 | image_tag: widths: '100, 200, 400', alt: shop.name }}{% else %}<span class="storefront-logo-text">{{ shop.name | escape }}</span>{% endif %}
  </a>
  <div class="mobail-menu d-lg-none"><button type="button" class="navbar-toggler open-btn" aria-label="{{ 'sections.header.menu' | t }}"><span class="icon-bar first-angle"></span><span class="icon-bar middle-angle"></span><span class="icon-bar last-angle"></span></button></div>
  <div id="navbar" class="collapse navbar-collapse navigation-holder">
    <button type="button" class="menu-close" aria-label="{{ 'accessibility.close' | t }}"><i class="ti-close" aria-hidden="true"></i></button>
    <ul class="nav navbar-nav mb-2 mb-lg-0">
      {% if section.settings.menu != blank %}{% render 'navigation-links', menu: section.settings.menu %}
      {% else %}<li><a href="{{ routes.root_url }}">{{ 'storefront.home' | t }}</a></li><li><a href="{{ settings.catalog_collection.url | default: routes.all_products_collection_url }}">{{ 'storefront.all_products' | t }}</a></li><li><a href="{{ routes.collections_url }}">{{ 'storefront.all_categories' | t }}</a></li>{% endif %}
    </ul>
  </div>
  <div class="storefront-header-tools">
    <form method="get" action="{{ routes.search_url }}" role="search">
      <label class="sr-only" for="HeaderSearch-{{ section.id }}">{{ 'general.search.search' | t }}</label>
      <input type="search" id="HeaderSearch-{{ section.id }}" name="q" placeholder="{{ 'storefront.search_placeholder' | t }}" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last">
      <button type="submit" aria-label="{{ 'general.search.search' | t }}"><i class="ti-search" aria-hidden="true"></i></button>
    </form>
    {% if shop.customer_accounts_enabled %}<a class="storefront-account" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}"><i class="ti-user" aria-hidden="true"></i></a>{% endif %}
    <div class="mini-cart">
      <button type="button" class="cart-toggle-btn" aria-controls="MiniCart-{{ section.id }}" aria-expanded="false" aria-haspopup="dialog" aria-label="{{ 'general.cart.view' | t: count: cart.item_count }}"><i><img src="{{ 'shopping-cart.png' | asset_url }}" width="24" height="24" alt=""></i><span class="cart-count">{{ cart.item_count }}</span></button>
      <div id="MiniCart-{{ section.id }}" class="mini-cart-content" role="dialog" aria-modal="false" aria-labelledby="MiniCartTitle-{{ section.id }}" inert>
        <button type="button" class="mini-cart-close" aria-label="{{ 'accessibility.close' | t }}"><i class="ti-close" aria-hidden="true"></i></button>
        <div class="mini-cart-items"><p class="top-p" id="MiniCartTitle-{{ section.id }}">{{ 'sections.cart.title' | t }} ({{ cart.item_count }})</p>
          {% if cart.empty? %}<p>{{ 'sections.cart.empty' | t }}</p><a class="theme-btn" href="{{ settings.catalog_collection.url | default: routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
          {% else %}<form action="{{ routes.cart_url }}" method="post">
            {% for item in cart.items %}<div class="mini-cart-item clearfix">
              <div class="mini-cart-item-image"><a href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">{% if item.image != blank %}{% assign item_image_alt = item.image.alt | default: item.product.title %}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item_image_alt }}{% endif %}</a></div>
              <div class="mini-cart-item-des"><p class="mini-cart-product-title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></p>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title | escape }}</small>{% endunless %}{% if item.selling_plan_allocation %}<small>{{ item.selling_plan_allocation.selling_plan.name | escape }}</small>{% endif %}<p><bdi>{{ item.final_line_price | money }}</bdi></p><a href="{{ item.url_to_remove }}" class="dlt-btn" aria-label="{{ 'sections.cart.remove_title' | t: title: item.product.title }}">{{ 'storefront.remove' | t }}</a></div>
              <label for="MiniQty-{{ forloop.index }}">{{ 'products.product.quantity.label' | t }}</label><input type="number" id="MiniQty-{{ forloop.index }}" name="updates[]" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" value="{{ item.quantity }}" {% if item.variant.quantity_rule.max != blank %}max="{{ item.variant.quantity_rule.max }}"{% endif %}>
            </div>{% endfor %}
            <div class="mini-cart-action clearfix"><p>{{ 'storefront.subtotal' | t }}: <bdi>{{ cart.total_price | money }}</bdi></p><button type="submit" name="update" class="theme-btn">{{ 'sections.cart.update' | t }}</button><a href="{{ routes.cart_url }}">{{ 'storefront.view_cart' | t }}</a><button type="submit" name="checkout" class="theme-btn">{{ 'sections.cart.checkout' | t }}</button></div>
          </form>{% endif %}
        </div>
      </div>
    </div>
  </div>
</div></div></nav></div></header>
{% schema %}
{
  "name": "t:storefront_editor.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:storefront_editor.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:storefront_editor.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
