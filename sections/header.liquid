<script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
<header id="header" class="storefront-header" data-cart-section="{{ section.id }}">
<div class="site-header header-style-1"><nav class="navigation navbar navbar-expand-lg navbar-light"><div class="container-fluid"><div class="row">
  <a class="navbar-brand storefront-menu-logo" href="{{ routes.root_url }}">
    {% assign header_logo = section.settings.logo | default: settings.logo %}{% assign header_logo_alt = header_logo.alt | default: shop.name %}
    {% if header_logo != blank %}{{ header_logo | image_url: width: 400 | image_tag: widths: '100, 200, 400', alt: header_logo_alt }}{% else %}<span class="storefront-logo-text">{{ shop.name | escape }}</span>{% endif %}
  </a>
  <div class="mobail-menu d-lg-none"><button type="button" class="navbar-toggler open-btn" aria-label="{{ 'sections.header.menu' | t }}"><span class="icon-bar first-angle"></span><span class="icon-bar middle-angle"></span><span class="icon-bar last-angle"></span></button></div>
    {% assign header_search_id = 'HeaderSearch-' | append: section.id %}
    {% render 'predictive-search', search_id: header_search_id %}
  <div class="storefront-header-secondary">
  <div id="navbar" class="collapse navbar-collapse navigation-holder">
    <button type="button" class="menu-close" aria-label="{{ 'accessibility.close' | t }}"><i class="ti-close" aria-hidden="true"></i></button>
    <ul class="nav navbar-nav mb-2 mb-lg-0">
      {% if section.settings.menu != blank %}{% render 'navigation-links', menu: section.settings.menu %}
      {% else %}<li><a href="{{ routes.root_url }}">{{ 'storefront.home' | t }}</a></li><li><a href="{{ settings.catalog_collection.url | default: routes.all_products_collection_url }}">{{ 'storefront.all_products' | t }}</a></li><li><a href="{{ routes.collections_url }}">{{ 'storefront.all_categories' | t }}</a></li>{% endif %}
      {% if settings.group_delivery_navigation %}{% capture delivery_entry %}{% render 'group-delivery-entry', menu: section.settings.menu, context: 'navigation' %}{% endcapture %}{% assign delivery_entry = delivery_entry | strip %}{% if delivery_entry != blank %}<li>{{ delivery_entry }}</li>{% endif %}{% endif %}
    </ul>
  </div>
  <div class="storefront-header-tools">
    {% if shop.customer_accounts_enabled %}<a class="storefront-account" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}"><i class="ti-user" aria-hidden="true"></i></a>{% endif %}
    <div class="mini-cart">
      <button type="button" class="cart-toggle-btn" data-count-label="{{ 'general.cart.view' | t: count: '__COUNT__' | escape }}" aria-controls="MiniCart-{{ section.id }}" aria-expanded="false" aria-haspopup="dialog" aria-label="{{ 'general.cart.view' | t: count: cart.item_count }}"><i><img src="{{ 'shopping-cart.png' | asset_url }}" width="24" height="24" alt="" aria-hidden="true" decoding="async"></i><span class="cart-count">{{ cart.item_count }}</span></button>
      {% render 'cart-drawer', drawer_id: section.id %}
    </div>
  </div>
  </div>
</div></div></nav></div></header>
{% schema %}
{
  "name": "t:storefront_editor.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:storefront_editor.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:storefront_editor.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
