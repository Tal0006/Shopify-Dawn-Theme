{% comment %}
  Compact homepage discovery link; no group or cart requests.
  Configure the destination under Theme settings > Group Delivery.
  @example Add after Trust Benefits on the homepage.
{% endcomment %}
{% assign delivery_page = settings.group_delivery_page | default: pages['group-delivery'] %}
{% if section.settings.enabled and delivery_page != blank %}
<section class="container group-delivery-promo" aria-labelledby="GroupDeliveryPromo-{{ section.id }}">
 <div class="group-delivery-promo__surface">
  <div class="group-delivery-promo__copy">
   <p class="group-delivery-promo__eyebrow">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'group_delivery_entry.heading' | t }}{% endif %}</p>
   <h2 id="GroupDeliveryPromo-{{ section.id }}">{% if section.settings.title != blank %}{{ section.settings.title | escape }}{% else %}{{ 'group_delivery_entry.title' | t }}{% endif %}</h2>
   <p>{% if section.settings.text != blank %}{{ section.settings.text | escape }}{% else %}{{ 'group_delivery_entry.text' | t }}{% endif %}</p>
   <p class="group-delivery-promo__approval">{{ 'group_delivery_entry.approval' | t }}</p>
  </div>
  <a class="theme-btn group-delivery-promo__cta" href="{{ delivery_page.url }}">{% if section.settings.cta_label != blank %}{{ section.settings.cta_label | escape }}{% else %}{{ 'group_delivery_entry.cta' | t }}{% endif %}</a>
 </div>
</section>
{% elsif request.design_mode and section.settings.enabled %}
<div class="container"><p>{{ 'group_delivery_entry.setup' | t }}</p></div>
{% endif %}
{% stylesheet %}
.group-delivery-promo {padding-block:12px 24px;}
.group-delivery-promo__surface {display:flex;align-items:center;justify-content:space-between;gap:20px 32px;padding:24px 28px;border:1px solid var(--storefront-border-soft);border-radius:16px;background:linear-gradient(115deg,#f8fdfdf5,#e9f7f8eb);box-shadow:var(--storefront-shadow);color:var(--storefront-ink);}
.group-delivery-promo__copy {min-width:0;max-width:64ch;}
.group-delivery-promo__copy p {margin:0;line-height:1.65;overflow-wrap:anywhere;}
.group-delivery-promo__eyebrow {color:var(--storefront-accent);font-size:14px;font-weight:500;}
.group-delivery-promo__copy h2 {font-size:clamp(22px,3vw,28px);line-height:1.3;margin:5px 0 8px;overflow-wrap:anywhere;}
.group-delivery-promo__copy .group-delivery-promo__approval {font-size:13px;color:#50646a;margin-block-start:6px;}
.group-delivery-promo .group-delivery-promo__cta {position:relative;isolation:isolate;overflow:hidden;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;min-height:48px;max-width:100%;padding:12px 20px;border:1px solid var(--storefront-cart-base,#0b6571);border-radius:12px;background:var(--storefront-cart-base,#0b6571);color:#fff;box-shadow:var(--storefront-cart-shadow);font-size:15px;line-height:1.5;white-space:normal;text-align:center;}
.group-delivery-promo .group-delivery-promo__cta::before {content:"";position:absolute;inset:0;width:100%;height:100%;z-index:-1;border:0;border-radius:inherit;background:var(--storefront-cart-highlight,#087b88);transform:translateX(100%);transition:transform 250ms var(--storefront-ease);pointer-events:none;}
.group-delivery-promo__cta:focus-visible {outline:3px solid var(--storefront-accent);outline-offset:3px;}
@media(hover:hover) and (pointer:fine) {.group-delivery-promo .group-delivery-promo__cta:hover::before {transform:translateX(0);}}
@media(max-width:767px) {
 .group-delivery-promo {padding-block:8px 16px;}
 .group-delivery-promo__surface {flex-direction:column;align-items:stretch;gap:14px;padding:18px;}
 .group-delivery-promo__copy p {font-size:14px;}
 .group-delivery-promo .group-delivery-promo__cta {width:100%;}
}
body:has(.a11y-launcher:not([hidden])) .group-delivery-promo {padding-inline-end:max(var(--page-padding,16px),calc(76px - max(0px,(100vw - var(--storefront-width,1200px))/2)));}
@media(min-width:992px) {body:has(fankee-shopping-assistant [data-launch]:not([hidden])) .group-delivery-promo {padding-inline-end:max(var(--page-padding,16px),calc(216px - max(0px,(100vw - var(--storefront-width,1200px))/2)));}}
@media(prefers-reduced-motion:reduce) {
 .group-delivery-promo .group-delivery-promo__cta::before {display:none;transition:none;}
 .group-delivery-promo .group-delivery-promo__cta:is(:hover,:active) {transform:none;}
}
html[data-a11y-paused] .group-delivery-promo__cta::before {display:none;}
/* Feature card: ambient glow, decorative ring and an eyebrow chip in the Group Delivery language. */
.group-delivery-promo__surface {position:relative;overflow:hidden;isolation:isolate;border-color:var(--fk-border);border-radius:var(--fk-radius-xl);background:radial-gradient(ellipse at 0% 0%,rgb(18 167 187 / 18%),transparent 52%),linear-gradient(115deg,#fff,var(--fk-cyan-50));box-shadow:var(--fk-shadow-md),inset 0 1px 0 #fff;}
.group-delivery-promo__surface::after {content:'';position:absolute;z-index:-1;inset-inline-start:-70px;inset-block-end:-90px;inline-size:240px;block-size:240px;border:1px solid rgb(18 167 187 / 20%);border-radius:50%;box-shadow:0 0 0 28px rgb(18 167 187 / 5%),0 0 0 56px rgb(18 167 187 / 3%);pointer-events:none;}
.group-delivery-promo__eyebrow {display:inline-flex;align-items:center;gap:6px;padding:3px 12px;border-radius:var(--fk-radius-pill);background:var(--fk-cyan-100);font-weight:600;}
.group-delivery-promo__eyebrow::before {content:'';inline-size:7px;block-size:7px;border-radius:50%;background:var(--fk-highlight);box-shadow:0 0 0 3px rgb(18 167 187 / 20%);}
.group-delivery-promo .group-delivery-promo__cta {background:var(--fk-gradient-primary);box-shadow:var(--fk-shadow-cta);}
{% endstylesheet %}
{% schema %}
{
  "name": "t:group_delivery_entry_editor.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:group_delivery_entry_editor.enabled",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:group_delivery_entry_editor.heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:group_delivery_entry_editor.title"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:group_delivery_entry_editor.text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:group_delivery_entry_editor.cta"
    }
  ],
  "presets": [
    {
      "name": "t:group_delivery_entry_editor.name"
    }
  ]
}
{% endschema %}
