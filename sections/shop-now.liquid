<!-- cta-area -->
<div class="cta-area section-padding pt-0">
  <div class="container">
    <div class="cta-wrap">
      <div class="row">
        <div class="col-lg-6 col-md-12 col-12">
          <div class="cta-item-left">
            <div class="cta-img">
              {% if section.settings.image != blank and section.settings.image.width != blank %}{%- assign shop_now_alt = section.settings.image.alt | default: section.settings.title | default: shop.name -%}{{ section.settings.image | image_url: width: 900 | image_tag: widths: '450, 900', sizes: '(min-width: 992px) 45vw, 90vw', loading: 'lazy', alt: shop_now_alt }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
              <a href="{{ section.settings.button_url | default: settings.catalog_collection.url | default: routes.all_products_collection_url | escape }}" class="theme-btn">{% if section.settings.button_text != blank %}{{ section.settings.button_text }}{% else %}{{ 'storefront.shop_now' | t }}{% endif %}</a>
            </div>
          </div>
        </div>
        <div class="col-lg-6 col-md-12 col-12">
          <div class="cta-item">
            <div class="cta-item-box">
              <div class="title">
                <h3>{% if section.settings.title != blank %}{{ section.settings.title }}{% else %}{{ 'storefront.featured_title' | t }}{% endif %}</h3>
              </div>
              <h2>
                {{ section.settings.subtitle -}}
                <span><img src="{{ 'shape1.png' | asset_url }}" class="fk-img-auto" width="170" height="147" alt="" aria-hidden="true" loading="lazy" decoding="async"></span>
                {{- section.settings.subtitle2 }}
              </h2>
              <h4>{{ section.settings.subtitle3 }}</h4>
              {{ section.settings.textList }}
              {{ section.settings.ingredients }}
              <small>{{ section.settings.small2 }}</small>
            </div>
            <div class="cta-bottom">
              <p>
                <span>{{ section.settings.vitamin }}</span>{{ section.settings.small }}
              </p>
              <p>
                <strong>{{ section.settings.nutrition1 }}</strong> {{ section.settings.nutrition }}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:storefront_editor.shop",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:storefront_editor.image"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:storefront_editor.link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:storefront_editor.button_text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:storefront_editor.heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:storefront_editor.subtitle"
    },
    {
      "type": "text",
      "id": "subtitle2",
      "label": "t:storefront_editor.subtitle"
    },
    {
      "type": "text",
      "id": "subtitle3",
      "label": "t:storefront_editor.text"
    },
    {
      "type": "liquid",
      "id": "textList",
      "label": "t:storefront_editor.text"
    },
    {
      "type": "richtext",
      "id": "ingredients",
      "label": "t:storefront_editor.text"
    },
    {
      "type": "text",
      "id": "small2",
      "label": "t:storefront_editor.text"
    },
    {
      "type": "text",
      "id": "vitamin",
      "label": "t:storefront_editor.text"
    },
    {
      "type": "text",
      "id": "small",
      "label": "t:storefront_editor.text"
    },
    {
      "type": "text",
      "id": "nutrition1",
      "label": "t:storefront_editor.text"
    },
    {
      "type": "text",
      "id": "nutrition",
      "label": "t:storefront_editor.text"
    }
  ],
  "presets": [
    {
      "name": "t:storefront_editor.shop"
    }
  ]
}
{% endschema %}
