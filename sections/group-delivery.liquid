{% comment %}
  Phase-one group pledges. Public service URL only; all prices and persistence are server-owned.
  Assign page.group-delivery to a Shopify Page. Theme Editor may override the public service origin.
{% endcomment %}
{% assign group_delivery_service_url = section.settings.service_url | default: 'https://fankee-group-delivery.onrender.com' %}
<fankee-group-delivery class="container group-delivery" data-service-url="{{ group_delivery_service_url | escape }}" data-cart-url="{{ routes.cart_url }}.js"
 data-error="{{ 'group_delivery.error' | t | escape }}" data-empty="{{ 'group_delivery.empty_cart' | t | escape }}" data-unavailable="{{ 'group_delivery.cart_unavailable' | t | escape }}"
 data-geo-error="{{ 'group_delivery.geo_error' | t | escape }}" data-geo-ready="{{ 'group_delivery.geo_ready' | t | escape }}" data-joined="{{ 'group_delivery.joined' | t | escape }}"
 data-found="{{ 'group_delivery.found' | t | escape }}" data-updated="{{ 'group_delivery.updated' | t | escape }}" data-area="{{ 'group_delivery.area' | t: area: '__AREA__' | escape }}"
 data-count="{{ 'group_delivery.participants' | t: count: '__COUNT__' | escape }}" data-remaining="{{ 'group_delivery.remaining' | t: amount: '__AMOUNT__' | escape }}"
 data-update-label="{{ 'group_delivery.update' | t | escape }}" data-join-label="{{ 'group_delivery.join' | t | escape }}" data-closed="{{ 'group_delivery.closed' | t | escape }}" data-setup="{{ 'group_delivery.setup' | t | escape }}"
 data-duplicate="{{ 'group_delivery.duplicate' | t | escape }}" data-almost="{{ 'group_delivery.almost' | t | escape }}" data-reached="{{ 'group_delivery.reached' | t | escape }}" data-waiting="{{ 'group_delivery.waiting' | t | escape }}" data-share-text="{{ 'group_delivery.share_text' | t: area: '__AREA__', amount: '__AMOUNT__', target: '__TARGET__' | escape }}" data-shopify-error="{{ 'group_delivery.shopify_error' | t | escape }}" data-invalid-cart="{{ 'group_delivery.invalid_cart' | t | escape }}" data-count-one="{{ 'group_delivery.participant_one' | t | escape }}" data-estimate="{{ 'group_delivery.verified_cart' | t | escape }}" data-pledge-label="{{ 'group_delivery.your_pledge' | t | escape }}" data-standard="{{ 'group_delivery.standard' | t | escape }}" data-locale="{{ request.locale.iso_code }}">
 <header><p class="group-delivery__eyebrow">{{ 'group_delivery.heading' | t }}</p><h1>{{ 'group_delivery.intro' | t }}</h1><h2>{{ 'group_delivery.promise' | t }}</h2><p>{{ 'group_delivery.description' | t }}</p></header>
 <p class="group-delivery__notice">{{ 'group_delivery.notice' | t }}</p>
 <form data-find-group>
  <label for="GroupArea-{{ section.id }}">{{ 'group_delivery.location' | t }}</label>
  <input id="GroupArea-{{ section.id }}" name="area" required maxlength="60" minlength="2" autocomplete="address-level2" aria-describedby="GroupLocationHint-{{ section.id }}">
  <p id="GroupLocationHint-{{ section.id }}" class="group-delivery__hint">{{ 'group_delivery.location_hint' | t }}</p>
  <div class="group-delivery__actions"><button type="button" class="group-delivery__secondary" data-geolocate>{{ 'group_delivery.geolocate' | t }}</button><button class="theme-btn" type="submit">{{ 'group_delivery.find' | t }}</button></div>
 </form>
 <div class="group-delivery__cart">{{ 'group_delivery.current_cart' | t }} <bdi data-current-cart>—</bdi></div><div class="group-delivery__notice" data-empty-cart hidden><strong>{{ 'group_delivery.empty_heading' | t }}</strong><p>{{ 'group_delivery.empty_cart' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'group_delivery.shop' | t }}</a></div>
 <p class="group-delivery__hint">{{ 'group_delivery.valuation' | t }}</p>
 <section class="group-delivery__panel" data-group-panel hidden aria-labelledby="GroupTitle-{{ section.id }}">
  <h2 id="GroupTitle-{{ section.id }}" data-group-title></h2>
  <p class="group-delivery__status" data-group-state></p>
  <div class="group-delivery__totals"><bdi data-pledged></bdi><span>{{ 'group_delivery.of' | t }}</span><bdi data-threshold></bdi></div>
  <div class="group-delivery__progress" role="progressbar" aria-label="{{ 'group_delivery.progress' | t | escape }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-progress-fill></span></div>
  <div class="group-delivery__summary"><span><bdi data-percent></bdi> {{ 'group_delivery.complete' | t }}</span><span data-remaining></span></div><div class="group-delivery__milestone" data-milestone-message hidden role="status" aria-live="polite"><strong data-milestone-title></strong><p data-milestone-detail></p></div>
  <div class="group-delivery__stats"><p class="group-delivery__people"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6m3 11v-3a6 6 0 0 0-3-5"/></svg> <span data-participants></span></p>
  <p class="group-delivery__hint">{{ 'group_delivery.expires' | t }} <time data-expiry></time></p></div>
  <p class="group-delivery__pledge" data-validated-pledge hidden><span data-pledge-label>{{ 'group_delivery.verified_cart' | t }}</span> <bdi></bdi></p>
  <form data-join-group>
   <fieldset data-contact-fields><legend>{{ 'group_delivery.contact' | t }}</legend>
    <label for="GroupEmail-{{ section.id }}">{{ 'group_delivery.email' | t }}</label><input id="GroupEmail-{{ section.id }}" type="email" name="email" required maxlength="254" autocomplete="email">
    <label for="GroupPhone-{{ section.id }}">{{ 'group_delivery.phone' | t }}</label><input id="GroupPhone-{{ section.id }}" type="tel" name="phone" required maxlength="24" autocomplete="tel" dir="ltr">
   </fieldset>
   <button class="theme-btn" type="submit" data-join-button disabled>{{ 'group_delivery.join' | t }}</button>
  </form>
  <div class="group-delivery__actions"><button type="button" class="group-delivery__secondary" data-refresh>{{ 'group_delivery.refresh' | t }}</button><button type="button" class="group-delivery__secondary" data-share disabled>{{ 'group_delivery.share' | t }}</button></div>
 </section>
 <p data-group-message role="status" aria-live="polite" aria-atomic="true"></p>
 <noscript><p>{{ 'group_delivery.javascript' | t }}</p></noscript>
 <script type="application/json" data-group-labels>{% assign group_states = 'OPEN,THRESHOLD_REACHED,APPROVED,PAYMENT_OPEN,CONFIRMED,SCHEDULED,COMPLETED,EXPIRED,CANCELLED' | split: ',' %}{ {% for state in group_states %}{% assign state_key = state | downcase | prepend: 'group_delivery.status.' %}{{ state | json }}:{{ state_key | t | json }}{% unless forloop.last %},{% endunless %}{% endfor %} }</script>
</fankee-group-delivery>
<script src="{{ 'group-delivery.js' | asset_url }}" defer></script>
{% stylesheet %}
.group-delivery { display:block;max-width:780px;margin-block:32px;color:var(--storefront-ink); }
.group-delivery [hidden] { display:none; }
.group-delivery header h1 {font-size:clamp(25px,4vw,36px);line-height:1.3;margin:8px 0;}
.group-delivery header h2 {font-size:22px;margin:8px 0;}
.group-delivery header p {line-height:1.7;}
.group-delivery__eyebrow {color:var(--storefront-accent);font-weight:600;}
.group-delivery__notice,.group-delivery__panel,.group-delivery [data-find-group] {padding:20px;border:1px solid var(--storefront-border-soft,#cfe4e8);border-radius:16px;background:#ffffffef;box-shadow:var(--storefront-shadow);margin-block:16px;}
.group-delivery__notice {background:#edf8fa;font-size:14px;}
.group-delivery label {display:block;margin-block:10px 5px;font-weight:500;}
.group-delivery input {width:100%;min-width:0;min-height:44px;padding:10px 12px;border:1px solid #aacbd2;border-radius:10px;background:#fff;color:inherit;}
.group-delivery :is(input,button):focus-visible {outline:2px solid var(--storefront-accent,#086b7b);outline-offset:3px;}
.group-delivery fieldset {border:0;padding:0;margin:0 0 16px;min-width:0;}
.group-delivery legend {font-size:16px;font-weight:600;}
.group-delivery__actions {display:flex;flex-wrap:wrap;gap:10px;margin-block:14px;}
.group-delivery button {min-height:44px;max-width:100%;white-space:normal;line-height:1.4;}
.group-delivery__secondary {padding:9px 14px;border:1px solid #aacbd2;background:#f0f9fa;border-radius:10px;color:#095564;}
.group-delivery button:disabled {opacity:.6;cursor:default;}
.group-delivery__hint {font-size:13px;color:#536975;line-height:1.6;}
.group-delivery__status {color:#095564;font-weight:600;}
.group-delivery__totals {display:flex;gap:10px;flex-wrap:wrap;align-items:baseline;font-size:20px;font-weight:600;}
.group-delivery__progress {height:10px;border-radius:20px;overflow:hidden;background:#dceef1;margin-block:14px;}
.group-delivery__progress span {display:block;width:100%;height:100%;background:var(--storefront-accent,#086b7b);transform:scaleX(0);transform-origin:right;transition:transform 220ms var(--storefront-ease,ease);}
.group-delivery:dir(ltr) .group-delivery__progress span {transform-origin:left;}
.group-delivery__panel h2 {font-size:23px;overflow-wrap:anywhere;}
.group-delivery [data-join-button] {width:100%;}
.group-delivery[aria-busy=true] form {opacity:.7;}
body:has(.a11y-launcher:not([hidden])) .group-delivery {padding-inline-end:max(16px,calc(76px - max(0px,(100vw - 780px)/2)));}
@media(min-width:992px) {body:has(fankee-shopping-assistant [data-launch]:not([hidden])) .group-delivery {padding-inline-end:max(16px,calc(216px - max(0px,(100vw - 780px)/2)));}}
@media(max-width:599px) {
 .group-delivery {margin-block:22px;}
 .group-delivery__panel,.group-delivery [data-find-group],.group-delivery__notice {padding:14px;}
 .group-delivery__actions>button {flex:1 1 140px;}
 .group-delivery__panel h2 {font-size:20px;}
}
@media(prefers-reduced-motion:reduce) {.group-delivery__progress span {transition:none;}}

.group-delivery {padding-block-end:env(safe-area-inset-bottom,0px);}
.group-delivery input {transition:border-color 180ms,box-shadow 180ms;}
.group-delivery input:focus {border-color:var(--storefront-accent);box-shadow:0 0 0 4px #12a7bb16;}
.group-delivery .theme-btn {position:relative;isolation:isolate;overflow:hidden;background:var(--storefront-accent,#086b7b);color:#fff;border:1px solid transparent;border-radius:12px;padding:12px 18px;box-shadow:0 5px 14px #089bad24;transition:transform 140ms,box-shadow 220ms,background-color 220ms;}
.group-delivery .theme-btn::before {content:"";position:absolute;inset:0;z-index:-1;background:#098a9b;transform:translateX(101%);transition:transform 250ms var(--storefront-ease,ease);pointer-events:none;}
.group-delivery .theme-btn:active:not(:disabled) {transform:scale(.985);}
.group-delivery__cart {display:flex;justify-content:space-between;gap:12px;align-items:center;padding:14px 18px;background:#edf8fa;border:1px solid var(--storefront-border-soft);border-radius:12px;}
.group-delivery__cart bdi {font-size:23px;font-weight:600;}
.group-delivery__panel h2 {margin:0 0 10px;}
.group-delivery__status {display:inline-flex;background:#e7f6f7;border:1px solid #c5e7eb;border-radius:30px;padding:5px 12px;font-size:13px;margin:0 0 18px;}
.group-delivery__totals [data-pledged] {font-size:clamp(27px,5vw,36px);}
.group-delivery__totals span,.group-delivery__totals [data-threshold] {font-size:16px;color:#536975;font-weight:400;}
.group-delivery__progress {height:14px;background:#e7eff1;margin-block:14px 10px;}
.group-delivery__panel[data-milestone=middle] [data-progress-fill] {background:#078594;}
.group-delivery__panel[data-milestone=almost] [data-progress-fill] {background:#0797a5;}
.group-delivery__panel[data-milestone=success] [data-progress-fill] {background:#087d68;}
.group-delivery__summary,.group-delivery__stats {display:flex;justify-content:space-between;align-items:center;gap:8px 16px;flex-wrap:wrap;font-size:14px;}
.group-delivery__summary [data-percent] {font-weight:600;color:var(--storefront-accent);}
.group-delivery__stats {margin-block:12px;border-block:1px solid var(--storefront-border-soft);}
.group-delivery__people {font-weight:500;color:#095564;}
.group-delivery__milestone {margin-block:14px;padding:12px 14px;border-radius:12px;background:#e9f8f5;color:#075c52;}
.group-delivery__milestone p {margin:4px 0 0;font-size:14px;}
.group-delivery__pledge {display:flex;justify-content:space-between;gap:12px;align-items:center;padding:14px;background:#edf8fa;border-inline-start:3px solid var(--storefront-accent);border-radius:10px;font-size:14px;}
.group-delivery__pledge bdi {font-size:22px;font-weight:600;}
.group-delivery button[aria-busy=true] {cursor:wait;box-shadow:none;}
.group-delivery button[aria-busy=true]::after {content:"";display:inline-block;width:14px;height:14px;margin-inline-start:8px;border:2px solid currentColor;border-inline-end-color:transparent;border-radius:50%;animation:group-delivery-spin 700ms linear infinite;vertical-align:middle;}
@keyframes group-delivery-spin {to {rotate:360deg;}}
@media(hover:hover) and (pointer:fine) {
 .group-delivery .theme-btn:hover:not(:disabled) {transform:translateY(-1px);box-shadow:0 8px 20px #089bad35;}
 .group-delivery .theme-btn:hover:not(:disabled)::before {transform:translateX(0);}
}
@media(max-width:599px) {
 .group-delivery [data-find-group] .theme-btn {width:100%;}
 .group-delivery__summary {font-size:13px;}
 .group-delivery__stats {gap:0 12px;}
 .group-delivery__stats p {margin-block:8px;}
}
@media(prefers-reduced-motion:reduce) {
 .group-delivery .theme-btn::before {display:none;}
 .group-delivery .theme-btn:is(:hover,:active) {transform:none;}
 .group-delivery button[aria-busy=true]::after {animation:none;}
}
.group-delivery__people {display:flex;align-items:center;gap:7px;}
.group-delivery__pledge[data-joined=true] {background:#e5f5f0;border-inline-start-color:#087d68;}
{% endstylesheet %}
{% schema %}
{"name":"t:storefront_editor.group_delivery","settings":[{"type":"url","id":"service_url","label":"t:storefront_editor.group_delivery_url"}],"presets":[{"name":"t:storefront_editor.group_delivery"}]}
{% endschema %}
