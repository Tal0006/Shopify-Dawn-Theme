{% comment %}
  Section contract.
  Group Delivery page explanation: a three-step "how it works" list and a short FAQ. Every text is an editable
  section setting; an empty setting falls back to the translated default in locales. An FAQ question is shown only
  once its answer is filled in, so the page never states targets, towns or payment terms that were not confirmed.
  @example
  <!-- templates/page.group-delivery.json, after the main group-delivery section -->
{% endcomment %}
{%- liquid
  assign gdi_answers = 0
  for i in (1..4)
    assign answer_key = 'faq_' | append: i | append: '_answer'
    if section.settings[answer_key] != blank
      assign gdi_answers = gdi_answers | plus: 1
    endif
  endfor
  assign gdi_steps_heading = section.settings.steps_heading | strip
  if gdi_steps_heading == blank
    assign gdi_steps_heading = 'group_delivery_info.steps_heading' | t
  endif
  assign gdi_faq_heading = section.settings.faq_heading | strip
  if gdi_faq_heading == blank
    assign gdi_faq_heading = 'group_delivery_info.faq_heading' | t
  endif
-%}
<section class="gd-info container section-padding">
  <div class="gd-info__steps">
    <h2 id="GroupInfoSteps-{{ section.id }}" class="gd-info__heading">{{ gdi_steps_heading | escape }}</h2>
    <ol class="gd-info__list" role="list" aria-labelledby="GroupInfoSteps-{{ section.id }}">
      {%- for i in (1..3) -%}
        {%- liquid
          assign title_key = 'step_' | append: i | append: '_title'
          assign text_key = 'step_' | append: i | append: '_text'
          assign step_title = section.settings[title_key] | strip
          if step_title == blank
            assign locale_key = 'group_delivery_info.' | append: title_key
            assign step_title = locale_key | t
          endif
          assign step_text = section.settings[text_key] | strip
          if step_text == blank
            assign locale_key = 'group_delivery_info.' | append: text_key
            assign step_text = locale_key | t
          endif
        -%}
        <li class="gd-info__step">
          <span class="gd-info__number" aria-hidden="true">{{ i }}</span>
          <div>
            <h3 class="gd-info__step-title">{{ step_title | escape }}</h3>
            <p class="gd-info__step-text">{{ step_text | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
  {%- if gdi_answers > 0 -%}
  <div class="gd-info__faq">
    <h2 id="GroupInfoFaq-{{ section.id }}" class="gd-info__heading">{{ gdi_faq_heading | escape }}</h2>
    {%- for i in (1..4) -%}
      {%- liquid
        assign question_key = 'faq_' | append: i | append: '_question'
        assign answer_key = 'faq_' | append: i | append: '_answer'
        assign faq_answer = section.settings[answer_key] | strip
        assign faq_question = section.settings[question_key] | strip
        if faq_question == blank
          assign locale_key = 'group_delivery_info.' | append: question_key
          assign faq_question = locale_key | t
        endif
      -%}
      {%- if faq_answer != blank -%}
      <details class="gd-info__item">
        <summary>{{ faq_question | escape }}</summary>
        <p>{{ faq_answer | escape | newline_to_br }}</p>
      </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>

{% stylesheet %}
.gd-info { display: grid; gap: clamp(20px, 3vw, 32px); }
.gd-info__heading { margin: 0 0 14px; font-size: clamp(21px, 2.4vw, 27px); line-height: 1.35; color: var(--fk-teal-900, #0a3f47); }
.gd-info__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
.gd-info__step { display: flex; align-items: flex-start; gap: 12px; min-width: 0; padding: 16px; border: 1px solid var(--fk-border, #d7e9ec); border-radius: var(--fk-radius-lg, 16px); background: linear-gradient(160deg, #fff, var(--fk-cyan-50, #f0fafb)); box-shadow: var(--fk-shadow-sm, 0 2px 10px rgb(11 79 88 / 8%)); }
.gd-info__number { flex: 0 0 36px; display: grid; place-items: center; inline-size: 36px; block-size: 36px; border-radius: 50%; background: var(--fk-teal-700, #0b6571); color: #fff; font-weight: 800; }
.gd-info__step-title { margin: 0 0 4px; font-size: 17px; line-height: 1.4; color: var(--fk-teal-900, #0a3f47); overflow-wrap: anywhere; }
.gd-info__step-text { margin: 0; color: var(--fk-text-muted, #4b636b); line-height: 1.6; overflow-wrap: anywhere; }
.gd-info__faq { display: grid; gap: 8px; }
.gd-info__item { border: 1px solid var(--fk-border, #d7e9ec); border-radius: var(--fk-radius-md, 12px); background: #fff; }
.gd-info__item summary { display: flex; align-items: center; min-height: 48px; padding: 10px 16px; font-weight: 700; color: var(--fk-teal-900, #0a3f47); cursor: pointer; overflow-wrap: anywhere; }
.gd-info__item summary:focus-visible { outline: 3px solid var(--fk-teal-800, #0b4f58); outline-offset: 2px; }
.gd-info__item p { margin: 0; padding: 0 16px 14px; line-height: 1.7; overflow-wrap: anywhere; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:group_delivery_info_editor.name",
  "settings": [
    { "type": "paragraph", "content": "t:group_delivery_info_editor.info" },
    { "type": "header", "content": "t:group_delivery_info_editor.steps" },
    { "type": "text", "id": "steps_heading", "label": "t:group_delivery_info_editor.steps_heading" },
    { "type": "text", "id": "step_1_title", "label": "t:group_delivery_info_editor.step_1_title" },
    { "type": "textarea", "id": "step_1_text", "label": "t:group_delivery_info_editor.step_1_text" },
    { "type": "text", "id": "step_2_title", "label": "t:group_delivery_info_editor.step_2_title" },
    { "type": "textarea", "id": "step_2_text", "label": "t:group_delivery_info_editor.step_2_text" },
    { "type": "text", "id": "step_3_title", "label": "t:group_delivery_info_editor.step_3_title" },
    { "type": "textarea", "id": "step_3_text", "label": "t:group_delivery_info_editor.step_3_text" },
    { "type": "header", "content": "t:group_delivery_info_editor.faq" },
    { "type": "paragraph", "content": "t:group_delivery_info_editor.faq_info" },
    { "type": "text", "id": "faq_heading", "label": "t:group_delivery_info_editor.faq_heading" },
    { "type": "text", "id": "faq_1_question", "label": "t:group_delivery_info_editor.faq_1_question" },
    { "type": "textarea", "id": "faq_1_answer", "label": "t:group_delivery_info_editor.faq_1_answer" },
    { "type": "text", "id": "faq_2_question", "label": "t:group_delivery_info_editor.faq_2_question" },
    { "type": "textarea", "id": "faq_2_answer", "label": "t:group_delivery_info_editor.faq_2_answer" },
    { "type": "text", "id": "faq_3_question", "label": "t:group_delivery_info_editor.faq_3_question" },
    { "type": "textarea", "id": "faq_3_answer", "label": "t:group_delivery_info_editor.faq_3_answer" },
    { "type": "text", "id": "faq_4_question", "label": "t:group_delivery_info_editor.faq_4_question" },
    { "type": "textarea", "id": "faq_4_answer", "label": "t:group_delivery_info_editor.faq_4_answer" }
  ],
  "presets": [
    { "name": "t:group_delivery_info_editor.name" }
  ]
}
{% endschema %}
