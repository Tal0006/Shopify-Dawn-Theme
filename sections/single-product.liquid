{% comment %}Product purchase region. Product/variant content is rendered by Shopify and refreshed by product-page.js.{% endcomment %}
{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign primary_image = selected_variant.featured_image | default: product.featured_image
  assign pickup_locations = selected_variant.store_availabilities | where: 'pick_up_enabled', true
-%}
<script src="{{ 'product-page.js' | asset_url }}" defer></script>
<section class="product-page section-padding" data-product-page data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-variant-error="{{ 'storefront.product_variant_error' | t | escape }}" data-variant-updated="{{ 'storefront.product_variant_updated' | t | escape }}">
  <div class="container">
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-product-status></p>
    <div class="product-page__layout">
      <div class="product-page__gallery" data-product-gallery>
        <div class="product-page__stage">
          {% for image in product.images %}
            {% assign image_alt = image.alt | default: product.title %}
            {% assign source_width = image.width | at_most: 960 %}
            {% assign image_loading = 'lazy' %}{% if image.id == primary_image.id %}{% assign image_loading = 'eager' %}{% endif %}
            <div id="ProductImage-{{ section.id }}-{{ image.id }}" class="product-page__image" data-product-image="{{ image.id }}" {% unless image.id == primary_image.id %}hidden{% endunless %}>
              {{ image | image_url: width: source_width | image_tag: widths: '240, 480, 720, 960', sizes: '(min-width: 1200px) 550px, (min-width: 992px) 46vw, 92vw', loading: image_loading, alt: image_alt }}
            </div>
          {% else %}<p class="catalog-no-image">{{ 'storefront.no_image' | t }}</p>{% endfor %}
        </div>
        {% if product.images.size > 1 %}
          <div class="product-page__thumbnails" role="group" aria-label="{{ 'storefront.product_gallery' | t }}">
            {% for image in product.images %}
              <button type="button" data-product-image-target="{{ image.id }}" aria-controls="ProductImage-{{ section.id }}-{{ image.id }}" aria-pressed="{% if image.id == primary_image.id %}true{% else %}false{% endif %}" aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index | escape }}">
                {{ image | image_url: width: 144 | image_tag: widths: '72, 144', sizes: '64px', loading: 'lazy', alt: '' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="product-page__purchase" data-product-purchase data-selected-variant="{{ selected_variant.id }}" data-selected-price="{{ selected_variant.price }}" data-selected-available="{{ selected_variant.available }}" data-selected-unit-safe="{% if selected_variant.quantity_rule.min > 1 or selected_variant.quantity_rule.increment > 1 %}false{% else %}true{% endif %}">
        {% if section.settings.show_vendor and product.vendor != blank %}<p class="product-page__vendor">{{ product.vendor | escape }}</p>{% endif %}
        <h1>{{ product.title | escape }}</h1>
        <div class="product-page__price">{% render 'product-price', card_product: product, variant: selected_variant %}{% if selected_variant.compare_at_price > selected_variant.price %}<span class="product-page__sale">{{ 'products.product.on_sale' | t }}</span>{% endif %}</div>
        <p class="product-page__availability" data-available="{{ selected_variant.available }}">{% if selected_variant.available %}{{ 'products.product.inventory_in_stock' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</p>
        {% form 'product', product, id: form_id, class: 'catalog-product-form storefront-validated-form', data-card-cart: '' %}
          {% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ selected_variant.id }}">
          {% else %}
            <label for="Variant-{{ section.id }}">{{ product.options | join: ' / ' | escape }}
              <select name="id" id="Variant-{{ section.id }}" data-product-variant data-current-variant="{{ selected_variant.id }}" required>
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant.id == selected_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{% for value in variant.options %}{{ product.options[forloop.index0] | escape }}: {{ value | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>
                {% endfor %}
              </select>
            </label>
            <noscript><ul>{% for variant in product.variants %}{% if variant.available %}<li><a href="{{ variant.url }}">{{ variant.title | escape }}</a></li>{% endif %}{% endfor %}</ul></noscript>
          {% endif %}
          {% if product.selling_plan_groups != blank %}<label for="Plan-{{ section.id }}">{{ 'storefront.selling_plan' | t }}<select name="selling_plan" id="Plan-{{ section.id }}" {% if product.requires_selling_plan %}required{% endif %}><option value="">{% if product.requires_selling_plan %}{{ 'storefront.select_variant' | t }}{% else %}{{ 'storefront.one_time_purchase' | t }}{% endif %}</option>{% for group in product.selling_plan_groups %}<optgroup label="{{ group.name | escape }}">{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}</optgroup>{% endfor %}</select></label>{% endif %}
          <div class="product-page__quantity-field">
            <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
            <div class="catalog-quantity" data-quantity-controls>
              <button type="button" data-quantity-change="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}" disabled>−</button>
              <input id="Quantity-{{ section.id }}" name="quantity" type="number" min="{{ selected_variant.quantity_rule.min | default: 1 }}" step="{{ selected_variant.quantity_rule.increment | default: 1 }}" value="{{ selected_variant.quantity_rule.min | default: 1 }}" {% if selected_variant.quantity_rule.max != blank %}max="{{ selected_variant.quantity_rule.max }}"{% endif %} required>
              <button type="button" data-quantity-change="1" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}" {% if selected_variant.quantity_rule.max != blank and selected_variant.quantity_rule.max <= selected_variant.quantity_rule.min %}disabled{% endif %}>+</button>
            </div>
            {% if selected_variant.quantity_rule.min > 1 %}<small>{{ 'products.product.quantity.minimum_of' | t: quantity: selected_variant.quantity_rule.min }}</small>{% endif %}
            {% if selected_variant.quantity_rule.increment > 1 %}<small>{{ 'products.product.quantity.multiples_of' | t: quantity: selected_variant.quantity_rule.increment }}</small>{% endif %}
          </div>
{% render 'inventory-limit', inventory_variant: selected_variant %}
          <button class="theme-btn product-page__add" type="submit" name="add" data-pending-label="{{ 'storefront.cart_adding' | t | escape }}" aria-describedby="{{ form_id }}-Feedback" {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
          <p id="{{ form_id }}-Feedback" class="catalog-card-feedback" role="status" aria-live="polite" aria-atomic="true" data-card-feedback data-success="{{ 'storefront.cart_added' | t | escape }}" data-error="{{ 'storefront.cart_add_error' | t | escape }}" data-refresh-error="{{ 'storefront.cart_refresh_error' | t | escape }}"></p>
          {% if form.errors %}<div role="alert" class="storefront-form-errors">{{ form.errors | default_errors }}</div>{% endif %}
          {% if section.settings.show_dynamic_checkout and selected_variant.available %}{{ form | payment_button }}{% endif %}
        {% endform %}
        {% unless selected_variant.available %}{% render 'back-in-stock-trigger', bis_product: product, bis_variant: selected_variant, bis_class: 'product-page__notify' %}{% endunless %}
        {% render 'product-sticky-atc', sticky_product: product, sticky_variant: selected_variant %}
        {% render 'product-trust' %}
        {% if section.settings.shipping_text != blank or shop.shipping_policy.body != blank or section.settings.pickup_text != blank or pickup_locations.size > 0 %}
          <aside class="product-page__reassurance" aria-label="{{ 'storefront.product_delivery' | t }}">
            {% if section.settings.shipping_text != blank %}<p><strong>{{ 'storefront.shipping' | t }}</strong> {{ section.settings.shipping_text | strip_html | truncate: 130 }}</p>{% elsif shop.shipping_policy.body != blank %}<p>{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}</p>{% endif %}
            {% if section.settings.pickup_text != blank %}<p><strong>{{ 'storefront.pickup' | t }}</strong> {{ section.settings.pickup_text | strip_html | truncate: 130 }}</p>{% endif %}
            {% for availability in pickup_locations %}<p>{% if availability.available %}{{ 'products.product.pickup_availability.pick_up_available_at_html' | t: location_name: availability.location.name }} — {{ availability.pick_up_time | escape }}{% else %}{{ 'products.product.pickup_availability.pick_up_unavailable_at_html' | t: location_name: availability.location.name }}{% endif %}</p>{% endfor %}
          </aside>
        {% endif %}
        <a class="product-page__whatsapp" data-product-whatsapp data-message="{{ 'storefront.product_whatsapp_message' | t: title: product.title | escape }}" hidden>{{ 'storefront.product_whatsapp_question' | t }}</a>
      </div>
      {% if product.description != blank or section.settings.shipping_text != blank or shop.shipping_policy.body != blank or section.settings.pickup_text != blank or pickup_locations.size > 0 or section.settings.usage_text != blank or section.settings.additional_text != blank %}
      <div class="product-page__accordions">
        {% if product.description != blank %}<details open><summary>{{ 'products.product.description' | t }}</summary><div class="product-page__richtext">{{ product.description }}</div></details>{% endif %}
        {% if section.settings.shipping_text != blank or shop.shipping_policy.body != blank or section.settings.pickup_text != blank or pickup_locations.size > 0 %}
          <details><summary>{{ 'storefront.product_delivery' | t }}</summary><div class="product-page__richtext">
            {% if section.settings.shipping_text != blank %}{{ section.settings.shipping_text }}{% elsif shop.shipping_policy.body != blank %}<p>{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}</p>{% endif %}
            {{ section.settings.pickup_text }}
            {% for availability in pickup_locations %}<p>{% if availability.available %}{{ 'products.product.pickup_availability.pick_up_available_at_html' | t: location_name: availability.location.name }} — {{ availability.pick_up_time | escape }}{% else %}{{ 'products.product.pickup_availability.pick_up_unavailable_at_html' | t: location_name: availability.location.name }}{% endif %}</p>{% if availability.location.address %}{{ availability.location.address | format_address }}{% endif %}{% endfor %}
          </div></details>
        {% endif %}
        {% if section.settings.usage_text != blank %}<details><summary>{{ 'storefront.product_usage' | t }}</summary><div class="product-page__richtext">{{ section.settings.usage_text }}</div></details>{% endif %}
        {% if section.settings.additional_text != blank %}<details><summary>{{ 'storefront.product_additional' | t }}</summary><div class="product-page__richtext">{{ section.settings.additional_text }}</div></details>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
.product-page { color: var(--storefront-ink); background: #fff; }
.product-page__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "purchase gallery" "details details"; gap: 32px 40px; align-items: start; }
.product-page__purchase { grid-area: purchase; min-width: 0; }
.product-page__gallery { grid-area: gallery; min-width: 0; }
.product-page__stage { display: grid; place-items: center; min-height: 340px; height: clamp(340px, 38vw, 480px); padding: 20px; background: #f7f8f4; border: 1px solid var(--storefront-border); border-radius: 10px; }
.product-page__image { width: 100%; height: 100%; min-height: 0; display: flex; align-items: center; justify-content: center; }
.product-page [hidden] { display: none !important; }
.product-page__image img { display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; }
.product-page__thumbnails { display: flex; flex-wrap: wrap; gap: 10px; margin-block-start: 12px; }
.product-page__thumbnails button { display: grid; place-items: center; width: 72px; height: 72px; padding: 4px; border: 1px solid var(--storefront-border); border-radius: 8px; background: #fff; }
.product-page__thumbnails button[aria-pressed=true] { border: 2px solid var(--storefront-green); background: #f0f5ee; }
.product-page__thumbnails img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
.product-page__vendor { margin-block: 0 6px; color: #59665f; font-size: 14px; }
.product-page h1 { font-size: clamp(25px, 2.6vw, 34px); line-height: 1.35; margin-block: 0 14px; overflow-wrap: anywhere; }
.product-page__price { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
.product-page__price .catalog-price { font-size: 25px; gap: 12px; }
.product-page__price .catalog-price s { font-size: 16px; }
.product-page__sale { border-radius: 5px; padding: 3px 8px; background: #eef4eb; color: var(--storefront-green); font-size: 12px; font-weight: 600; }
.product-page__availability { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-block: 12px 0; color: #59665f; }
.product-page__availability[data-available=true] { color: var(--storefront-green); }
.product-page__availability::before { content: ''; flex-shrink: 0; width: 7px; height: 7px; background: currentColor; border-radius: 50%; }
.product-page .catalog-product-form { max-width: none; margin-block: 20px 16px; gap: 16px; }
.product-page .catalog-product-form select { width: 100%; }
.product-page__quantity-field { display: grid; gap: 8px; }
.product-page__quantity-field small { color: #59665f; }
.product-page .catalog-quantity { width: fit-content; border: 1px solid var(--storefront-border); border-radius: 8px; gap: 0; }
.product-page .catalog-quantity :is(button, input) { border: 0; border-radius: 0; width: 48px; min-height: 44px; padding: 8px; text-align: center; }
.product-page .catalog-quantity input { appearance: textfield; -moz-appearance: textfield; }
.product-page .catalog-quantity input::-webkit-inner-spin-button { appearance: none; }
.product-page .catalog-quantity button:disabled { opacity: .4; }
.product-page .product-page__add { width: 100%; min-height: 48px; background: var(--storefront-green); color: #fff; border: 1px solid var(--storefront-green); }
.product-page .product-page__add:not(:disabled):is(:hover, :focus-visible) { background: var(--fk-primary-strong); }
.product-page .product-page__add:disabled { background: #e6e9e7; color: #58635d; border-color: var(--storefront-border); }
.product-page .catalog-card-feedback:empty { display: none; }
.product-page__reassurance { border-block-start: 1px solid var(--storefront-border); padding-block-start: 12px; font-size: 13px; color: #59665f; }
.product-page__reassurance p { margin-block: 0 8px; }
.product-page__whatsapp { display: inline-flex; align-items: center; min-height: 44px; margin-block-start: 8px; color: var(--storefront-green); text-decoration: underline; text-underline-offset: 4px; }
.product-page__accordions { grid-area: details; min-width: 0; }
.product-page__accordions:empty { display: none; }
.product-page details { border-block-start: 1px solid var(--storefront-border); padding-block: 16px; }
.product-page summary { cursor: pointer; padding-block: 4px; font-weight: 600; min-height: 36px; }
.product-page__richtext { padding-block-start: 12px; max-width: 85ch; overflow-wrap: anywhere; }
.product-page__richtext :is(img, video, iframe, table) { max-width: 100%; }
.product-page__richtext img { height: auto; }
.product-page__richtext a { text-decoration: underline; text-underline-offset: 3px; }
.product-page[aria-busy=true] [data-product-purchase] { opacity: .65; }
@media (max-width: 991px) {
  .product-page__layout { grid-template-columns: minmax(0, 1fr); grid-template-areas: "gallery" "purchase" "details"; gap: 24px; }
  .product-page__stage { height: 340px; min-height: 0; }
}
@media (max-width: 600px) {
  .product-page__stage { height: 300px; padding: 16px; }
  .product-page__thumbnails button { width: 60px; height: 60px; }
  .product-page__price .catalog-price { font-size: 23px; }
}

/* Product detail surfaces; no variant, pricing or form behavior overrides. */
.product-page { background: transparent; }
.product-page__stage { border-color: var(--storefront-border-soft); border-radius: 16px; background: linear-gradient(145deg, #fff, #eff8fa); box-shadow: var(--storefront-shadow); }
.product-page__purchase h1 { font-size: clamp(25px, 2.4vw, 34px); line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
.product-page__price .catalog-price { font-size: clamp(24px, 2.2vw, 30px); color: #163e47; }
.product-page__price .catalog-price s { font-size: 16px; color: #59666b; }
.product-page__sale { background: #a6314d; color: #fff; border-radius: 20px; padding: 3px 10px; font-size: 12px; }
.product-page__availability { font-size: 14px; }
.product-page__thumbnails button { border-radius: 10px; border-color: var(--storefront-border-soft); }
.product-page__thumbnails button[aria-pressed=true] { border-color: var(--storefront-accent); background: #ecf7f9; }
.product-page .catalog-quantity { border-color: var(--storefront-border-soft); border-radius: 12px; background: #f5fafb; }
.product-page .catalog-quantity button { color: var(--storefront-accent); background: transparent; }
.product-page .catalog-quantity button:not(:disabled):hover { background: #e3f3f5; }
.product-page .catalog-quantity :is(input,button):focus-visible { outline: 2px solid var(--storefront-accent); outline-offset: -2px; }
.product-page__accordions details { border-color: var(--storefront-border-soft); }
.product-page__accordions summary { color: #184d58; font-weight: 600; }
.product-page__richtext { line-height: 1.8; }
@media (max-width: 599px) { .product-page__stage { height: 280px; } .product-page__layout { gap: 20px; } }

/* Premium purchase component: one raised glass panel, a quiet gallery stage and a dominant CTA.
   Presentation only; variant, quantity and inventory behaviour stay in product-page.js / storefront.js. */
.product-page { background: transparent; }
.product-page__purchase { padding: clamp(18px, 2.4vw, 28px); border: 1px solid var(--fk-border); border-radius: var(--fk-radius-xl); background: var(--fk-surface-elevated); box-shadow: var(--fk-shadow-md), inset 0 1px 0 #fff; transition: opacity var(--fk-dur) ease; }
@supports (backdrop-filter: blur(1px)) { @media (min-width: 992px) { .product-page__purchase { backdrop-filter: blur(10px); } } }
.product-page[aria-busy=true] [data-product-purchase] { opacity: .7; }
.product-page__stage { border-color: var(--fk-border); border-radius: var(--fk-radius-xl); background: radial-gradient(circle at 50% 46%, #fff 0 40%, var(--fk-cyan-50) 82%); box-shadow: inset 0 1px 0 #fff, var(--fk-shadow-sm); }
.product-page__image:not([hidden]) img { animation: fk-fade var(--fk-dur) var(--fk-ease-out); }
.product-page__thumbnails button { transition: border-color var(--fk-dur-fast) ease, box-shadow var(--fk-dur-fast) ease, transform var(--fk-dur-fast) ease; }
.product-page__thumbnails button[aria-pressed=true] { box-shadow: var(--fk-ring); }
.product-page__vendor { color: var(--fk-accent); font-weight: 600; letter-spacing: .02em; }
.product-page__purchase h1 { color: var(--fk-text); letter-spacing: -.01em; }
.product-page__price .catalog-price { font-weight: 800; color: var(--fk-teal-900); }
.product-page__sale { background: var(--fk-danger-bg); color: var(--fk-danger); border: 1px solid #f2c6d2; font-weight: 700; }
.product-page__availability[data-available=true] { color: var(--fk-success); }
.product-page .catalog-product-form select { min-height: 48px; padding-inline: 14px; background-color: #fff; }
.product-page .catalog-quantity { background: #fff; border-color: var(--fk-border-strong); box-shadow: var(--fk-shadow-sm); }
.product-page .catalog-quantity button { transition: background-color var(--fk-dur-fast) ease, color var(--fk-dur-fast) ease; }
.product-page .catalog-quantity button:not(:disabled):active { background: var(--fk-cyan-100); }
.product-page .product-page__add { min-height: 54px; font-size: 17px; border-radius: var(--fk-radius-md); }
.product-page__reassurance { border-color: var(--fk-border); color: var(--fk-text-muted); }
.product-trust + .product-page__reassurance { border-block-start: 0; padding-block-start: 0; }
.product-page__whatsapp { gap: 8px; padding-inline: 16px; border: 1px solid #b9e2c9; border-radius: var(--fk-radius-pill); background: #f0faf4; color: var(--fk-success); text-decoration: none; font-weight: 600; transition: background-color var(--fk-dur-fast) ease, border-color var(--fk-dur-fast) ease; }
.product-page__whatsapp::before { content: ''; inline-size: 8px; block-size: 8px; border-radius: 50%; background: #25d366; box-shadow: 0 0 0 3px rgb(37 211 102 / 20%); }
/* Accordions: custom chevron, larger target, content eases in when opened. */
.product-page__accordions { padding: 4px clamp(14px, 2vw, 22px); border: 1px solid var(--fk-border); border-radius: var(--fk-radius-lg); background: var(--fk-surface); box-shadow: var(--fk-shadow-sm); }
.product-page__accordions details:first-child { border-block-start: 0; }
.product-page__accordions summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; list-style: none; transition: color var(--fk-dur-fast) ease; }
.product-page__accordions summary::-webkit-details-marker { display: none; }
.product-page__accordions summary::after { content: ''; flex: 0 0 10px; inline-size: 10px; block-size: 10px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: translateY(-3px) rotate(45deg); transition: transform var(--fk-dur) var(--fk-ease-out); }
.product-page__accordions details[open] > summary::after { transform: translateY(2px) rotate(225deg); }
.product-page__accordions summary:hover { color: var(--fk-accent); }
.product-page__accordions details[open] > .product-page__richtext { animation: fk-rise var(--fk-dur) var(--fk-ease-out); }
@media (hover: hover) and (pointer: fine) {
 .product-page__thumbnails button:not([aria-pressed=true]):hover { border-color: var(--fk-border-strong); transform: translateY(-1px); }
 .product-page__whatsapp:hover { background: #e2f6ea; border-color: #8fd3aa; }
}
@media (max-width: 599px) {
 .product-page__purchase { padding: 16px; border-radius: var(--fk-radius-lg); }
 .product-page__accordions { padding-inline: 14px; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "t:storefront_editor.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:storefront_editor.show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:storefront_editor.show_dynamic_checkout",
      "default": false
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "t:storefront_editor.shipping_text"
    },
    {
      "type": "richtext",
      "id": "pickup_text",
      "label": "t:storefront_editor.pickup_text"
    },
    {
      "type": "richtext",
      "id": "usage_text",
      "label": "t:storefront_editor.product_usage"
    },
    {
      "type": "richtext",
      "id": "additional_text",
      "label": "t:storefront_editor.product_additional"
    }
  ]
}
{% endschema %}
