<div class="footer-area contact-page"><div class="footer-top"><div class="footer-wrap"><div class="row"><div class="col-lg-3"></div><div class="col-lg-6"><div class="contact-wrap"><div class="contact-title"><h1>{% if section.settings.title != blank %}{{ section.settings.title | escape }}{% else %}{{ 'storefront.contact' | t }}{% endif %}</h1><p>{% if section.settings.subtitle != blank %}{{ section.settings.subtitle | escape }}{% else %}{{ 'storefront.contact_intro' | t }}{% endif %}</p></div>
{% assign contact_id = 'ContactForm-' | append: section.id %}{% form 'contact', id: contact_id, class: 'storefront-validated-form' %}
<div class="row"><div class="col-lg-6 col-12 form-group"><label for="ContactFirst-{{ section.id }}">{{ 'storefront.first_name' | t }}</label><input type="text" id="ContactFirst-{{ section.id }}" name="contact[first_name]" autocomplete="given-name" value="{{ customer.first_name | escape }}"></div><div class="col-lg-6 col-12 form-group"><label for="ContactLast-{{ section.id }}">{{ 'storefront.last_name' | t }}</label><input type="text" id="ContactLast-{{ section.id }}" name="contact[last_name]" autocomplete="family-name" value="{{ customer.last_name | escape }}"></div>
<div class="col-12 form-group"><label for="ContactEmail-{{ section.id }}">{{ 'templates.contact.form.email' | t }}</label><input type="email" id="ContactEmail-{{ section.id }}" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactErrors-{{ section.id }}"{% endif %}></div>
<div class="col-12 form-group"><label for="ContactBody-{{ section.id }}">{{ 'templates.contact.form.comment' | t }}</label><textarea id="ContactBody-{{ section.id }}" name="contact[body]" required>{{ form.body | escape }}</textarea></div>
<div class="col-12 form-group"><button type="submit" class="theme-btn">{{ 'templates.contact.form.send' | t }}</button></div></div>
{% if form.posted_successfully? %}<p role="status">{{ 'templates.contact.form.post_success' | t }}</p>{% endif %}{% if form.errors %}<div id="ContactErrors-{{ section.id }}" role="alert">{{ 'templates.contact.form.error_heading' | t }}{{ form.errors | default_errors }}</div>{% endif %}
{% endform %}{% if section.settings.compnay != blank or section.settings.address != blank %}<p>{{ section.settings.compnay | escape }}<br>{{ section.settings.address | escape }}</p>{% endif %}</div></div></div></div></div></div>
{% schema %}
{
  "name": "t:storefront_editor.contact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:storefront_editor.heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:storefront_editor.subtitle"
    },
    {
      "type": "text",
      "id": "compnay",
      "label": "t:storefront_editor.company"
    },
    {
      "type": "text",
      "id": "address",
      "label": "t:storefront_editor.address"
    }
  ],
  "presets": [
    {
      "name": "t:storefront_editor.contact"
    }
  ]
}
{% endschema %}
