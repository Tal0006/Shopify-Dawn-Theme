<!-- features-area -->
<div class="features-area section-padding">
  <div class="container">
    <div class="features-wrap">
      <div class="title">
        <h2>{% if section.settings.title != blank %}{{ section.settings.title }}{% else %}{{ 'storefront.feature_title' | t }}{% endif %}</h2>
      </div>
      <div class="row">
        {% for block in section.blocks %}
          <div class="col-lg-4 col-md-6 col-12">
            <div class="features-item">
              <div class="features-img">
                {% if block.settings.image != blank and block.settings.image.width != blank %}<img src="{{ block.settings.image |  image_url: width: 500  }}" width="" height="" alt="">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
              </div>
              <div class="features-text">
                <h3>
                  <span><img src="{{ 'shape1.png' | asset_url }}" width="" height="" alt=""></span>
                  {% if block.settings.feature_title != blank %}{{ block.settings.feature_title | escape }}{% else %}{{ 'storefront.feature_title' | t }}{% endif %}
                </h3>
                <p>
                  {% if block.settings.description != blank %}{{ block.settings.description | escape }}{% else %}{{ 'storefront.feature_description' | t }}{% endif %}
                </p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="left-shape">
        <img
          src="{{ '80MG.png' | asset_url }}"
          width="90px"
          height="90px"
          alt=""
          class=""
        >
      </div>
      <div class="right-shape">
        <img
          src="{{ 'features-right.png' | asset_url }}"
          width=""
          height=""
          alt=""
        >
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:storefront_editor.features",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:storefront_editor.heading"
    }
  ],
  "blocks": [
    {
      "name": "t:storefront_editor.category",
      "type": "block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:storefront_editor.image"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "t:storefront_editor.heading"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:storefront_editor.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:storefront_editor.features",
      "blocks": [
        {
          "type": "block"
        }
      ]
    }
  ]
}
{% endschema %}
