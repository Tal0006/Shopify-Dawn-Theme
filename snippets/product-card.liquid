{% if card_product != blank %}
  {% assign card_variant = card_product.selected_or_first_available_variant %}
  <article class="catalog-card">
    <a href="{{ card_product.url }}" class="catalog-card__image">
      {% if card_product.featured_image != blank %}
        {{ card_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 450, 600', sizes: '(min-width: 1000px) 25vw, 50vw', alt: card_product.featured_image.alt }}
      {% else %}<span class="catalog-no-image">{{ 'storefront.no_image' | t }}</span>{% endif %}
      {% if card_variant.compare_at_price > card_variant.price %}<span class="catalog-badge">{{ 'products.product.on_sale' | t }}</span>{% endif %}
    </a>
    <div class="catalog-card__content">
      <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      {% render 'product-price', card_product: card_product %}
      <p class="catalog-availability">{% if card_product.available %}{{ 'products.product.inventory_in_stock' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</p>
      {% if card_product.available == false %}
        <button class="theme-btn" disabled>{{ 'products.product.sold_out' | t }}</button>
      {% elsif card_product.has_only_default_variant and card_product.requires_selling_plan == false %}
        {% assign card_form_id = 'CardProductForm-' | append: section.id | append: '-' | append: card_product.id %}
        {% form 'product', card_product, id: card_form_id, class: 'catalog-card__form' %}
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="{{ card_variant.quantity_rule.min | default: 1 }}">
          <button type="submit" class="theme-btn" name="add">{{ 'products.product.add_to_cart' | t }}</button>
        {% endform %}
      {% else %}
        <a class="theme-btn" href="{{ card_product.url }}">{{ 'products.product.choose_options' | t }}</a>
      {% endif %}
    </div>
  </article>
{% endif %}
