{% doc %}
  Business details from Theme Settings (legal name, business ID, address, phone, email, opening hours). Only
  filled fields render; nothing renders when all are empty.
  @example
  {% render 'business-details' %}
{% enddoc %}
{%- liquid
  assign biz_name = settings.business_legal_name | strip
  assign biz_id = settings.business_id | strip
  assign biz_address = settings.business_address | strip
  assign biz_phone = settings.business_phone | strip
  assign biz_email = settings.business_email | strip
  assign biz_hours = settings.business_hours | strip
  assign biz_tel = biz_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
-%}
{%- if biz_name != blank or biz_id != blank or biz_address != blank or biz_phone != blank or biz_email != blank or biz_hours != blank -%}
<div class="business-details">
  <h3 class="business-details__heading">{{ 'business_details.heading' | t }}</h3>
  <address class="business-details__list">
    {%- if biz_name != blank %}<p class="business-details__name">{{ biz_name | escape }}</p>{% endif -%}
    {%- if biz_id != blank %}<p><span class="business-details__label">{{ 'business_details.business_id' | t }}</span> <bdi>{{ biz_id | escape }}</bdi></p>{% endif -%}
    {%- if biz_address != blank %}<p><span class="business-details__label">{{ 'business_details.address' | t }}</span> {{ biz_address | escape | newline_to_br }}</p>{% endif -%}
    {%- if biz_phone != blank %}<p><span class="business-details__label">{{ 'business_details.phone' | t }}</span> <a href="tel:{{ biz_tel | escape }}" dir="ltr">{{ biz_phone | escape }}</a></p>{% endif -%}
    {%- if biz_email != blank %}<p><span class="business-details__label">{{ 'business_details.email' | t }}</span> <a href="mailto:{{ biz_email | escape }}" dir="ltr">{{ biz_email | escape }}</a></p>{% endif -%}
    {%- if biz_hours != blank %}<p><span class="business-details__label">{{ 'business_details.hours' | t }}</span> {{ biz_hours | escape | newline_to_br }}</p>{% endif -%}
  </address>
</div>
{%- endif -%}
{% stylesheet %}
.business-details { min-width: 0; margin-block-start: 16px; }
.business-details__heading { margin: 0 0 8px; font-size: 16px; line-height: 1.5; font-weight: 600; color: #fff; }
.business-details__list { display: grid; gap: 2px; margin: 0; font-style: normal; font-size: 14px; line-height: 1.7; color: #d8ecef; overflow-wrap: anywhere; }
.business-details__list p { margin: 0; }
.business-details__name { font-weight: 600; color: #fff; }
.business-details__label { color: #bdd7dc; }
.business-details__list a { display: inline-flex; align-items: center; min-height: 44px; color: #fff; text-decoration: underline; text-underline-offset: 3px; }
.business-details__list a:focus-visible { outline: 2px solid #b0e9ee; outline-offset: 3px; }
{% endstylesheet %}
