{% doc %}
  Shared lightweight storefront surfaces and motion. Does not style or replace logo assets.
  @example
  {% render 'storefront-design' %}
{% enddoc %}
{% stylesheet %}
:root {
 /* Component-facing aliases of the --fk-* tokens in assets/storefront.css. */
 --storefront-surface: var(--fk-surface);
 --storefront-glass: var(--fk-surface-elevated);
 --storefront-border-soft: var(--fk-border);
 --storefront-accent: var(--fk-accent);
 --storefront-cart-base: var(--fk-primary);
 --storefront-cart-highlight: var(--fk-primary-bright);
 --storefront-cart-shadow: var(--fk-shadow-cta);
 --storefront-shadow: var(--fk-shadow-sm);
 --storefront-shadow-raised: var(--fk-shadow-md);
 --storefront-glow: var(--fk-ring);
 --storefront-muted: var(--fk-text-muted);
 --storefront-ease: var(--fk-ease);
 --storefront-transition-fast: 200ms var(--storefront-ease);
 --storefront-transition-normal: 300ms var(--storefront-ease);
}
body { background: var(--fk-bg); }
#MainContent { position: relative; isolation: isolate; background: radial-gradient(ellipse at 95% 8%, #dff5f766, transparent 42%), radial-gradient(ellipse at 0% 45%, #e4effa80, transparent 42%), #fbfdfe; }
#MainContent[data-storefront-home]::before, #MainContent[data-storefront-home]::after { content: ''; position: absolute; pointer-events: none; z-index: -1; inset-inline: 5%; border-radius: 45%; animation: storefront-light-drift 38s ease-in-out infinite alternate; }
#MainContent[data-storefront-home]::before { inset-block-start: 40px; height: min(55vw, 620px); max-height: 70%; background: radial-gradient(ellipse at 12% 20%, #84dbe94d, transparent 58%), radial-gradient(ellipse at 86% 80%, #91bfea40, transparent 62%); }
#MainContent[data-storefront-home]::after { inset-block-start: 40%; height: min(42vw, 520px); max-height: 45%; background: radial-gradient(ellipse at 70% 45%, #81d8ce33, transparent 65%); animation-duration: 46s; animation-direction: alternate-reverse; }
:where(a, button, input, select, textarea, summary):focus-visible { outline-color: var(--storefront-accent); }
.storefront-header .site-header.header-fixed { background: var(--storefront-glass); border-block-end: 1px solid var(--storefront-border-soft); box-shadow: 0 6px 24px #16465614; animation-duration: 240ms; }
.storefront-header { background: var(--storefront-glass); border-block-end-color: var(--storefront-border-soft); box-shadow: 0 3px 16px #21495608; }
@supports (backdrop-filter: blur(8px)) {
 @media (min-width: 992px) { .storefront-header { backdrop-filter: blur(8px); } }
}
.storefront-header fankee-predictive-search input { background: #f6fbfc; border-color: var(--storefront-border-soft); border-radius: 12px; transition: border-color var(--storefront-transition-fast), box-shadow var(--storefront-transition-fast); }
.storefront-header fankee-predictive-search input:is(:focus, :focus-visible) { border-color: var(--storefront-accent); box-shadow: var(--storefront-glow); }
.storefront-header :is(.cart-toggle-btn, .open-btn, .nav-mega-trigger) { transition: background-color var(--storefront-transition-fast), color var(--storefront-transition-fast); border-radius: 8px; }
.storefront-header :is(.cart-toggle-btn, .open-btn, .nav-mega-trigger):active { background-color: #e5f3f5; }
[data-storefront-home] .hero-area { position: relative; isolation: isolate; background: radial-gradient(ellipse at 4% 10%, #9cdde75c, transparent 55%), radial-gradient(ellipse at 96% 85%, #96c7e85c, transparent 58%), linear-gradient(125deg, #f7fcfd, #dcefed 60%, #e6f1fb); border-block-end: 1px solid var(--storefront-border-soft); padding-block: clamp(44px, 6vw, 76px); }
[data-storefront-home] .hero-area::before { content: ''; pointer-events: none; position: absolute; z-index: -1; inset: 5%; border-radius: 50%; background: radial-gradient(ellipse at 22% 35%, #72cddd70, transparent 60%), linear-gradient(155deg, transparent 40%, #ffffffa3 50%, transparent 62%); animation: storefront-light-drift 26s ease-in-out infinite alternate; }
[data-storefront-home] .hero-area::after { content: ''; position: absolute; pointer-events: none; z-index: -1; inset: 14% 9%; border: 1px solid #84cbd554; border-radius: 45% 55% 60% 40% / 65% 55% 45% 35%; background: linear-gradient(170deg, transparent 44%, #ffffff73 50%, transparent 57%); animation: storefront-light-drift 34s ease-in-out infinite alternate-reverse; }
[data-storefront-home] .hero-btn .theme-btn { background: linear-gradient(120deg, #0b5d66, #08798a); color: #fff; border: 1px solid #0b6571; box-shadow: 0 6px 18px #106f7a29, 0 0 0 3px #bde9ed66; font-weight: 700; min-height: 48px; padding-inline: 28px; transition-duration: 220ms; }
[data-storefront-home] .hero-btn .theme-btn::before { display: none; }
[data-storefront-home] .hero-btn .theme-btn:active { transform: translateY(1px); box-shadow: 0 1px 4px #106f7a24; }
[data-storefront-home] .hero-area h1.storefront-hero-heading { color: var(--storefront-ink); text-wrap: balance; }
[data-storefront-home] .hero-area .storefront-hero-subtitle { color: #425d63; }
[data-storefront-home] .catalog-home {
 --card-border: var(--storefront-border-soft); --card-radius: 14px;
 --card-surface: #f6fafb; --card-bg: var(--storefront-surface);
 --card-shadow: var(--storefront-shadow); --card-shadow-hover: var(--storefront-shadow-raised);
 --card-transition: var(--storefront-transition-fast);
}
[data-storefront-home] .catalog-category { background: linear-gradient(145deg, #fff, #f4fafb); }
[data-storefront-home] .catalog-category__media { border-radius: 10px; }
[data-storefront-home] .catalog-category img { transition: transform var(--storefront-transition-fast); }
[data-storefront-home] .catalog-home .catalog-card .theme-btn:not(:disabled) { background: #0b6571; border-color: #0b6571; color: #fff; }
[data-storefront-home] .catalog-home .catalog-card .theme-btn:not(:disabled):is(:hover, :focus-visible) { background: #084f59; }
.storefront-header .nav-mega-trigger:is(:hover, :focus-visible) { color: var(--storefront-accent); }
[data-storefront-home] .catalog-section-header { border-block-end-color: var(--storefront-border-soft); }
:is(.theme-btn, .theme-btn-2, .theme-btn-4), fankee-shopping-assistant .shopping-assistant__primary { border-radius: 12px; transition: transform var(--storefront-transition-fast), box-shadow var(--storefront-transition-fast), background-color var(--storefront-transition-fast); }
:is(.theme-btn, .theme-btn-2, .theme-btn-4):not(:disabled):active, fankee-shopping-assistant .shopping-assistant__primary:not(:disabled):active { transform: translateY(1px); box-shadow: none; }
fankee-shopping-assistant .shopping-assistant__launcher { border-color: var(--fk-cyan-200); border-radius: var(--fk-radius-pill); background: linear-gradient(125deg, var(--fk-teal-800), var(--fk-teal-600)); box-shadow: 0 6px 20px rgb(11 79 88 / 22%), 0 0 0 3px rgb(223 245 247 / 70%); font-weight: 600; transition: box-shadow var(--storefront-transition-fast), transform var(--fk-dur-fast) ease; }
fankee-shopping-assistant .shopping-assistant__launcher svg { transition: transform var(--fk-dur) var(--fk-ease-out); }
:is([data-storefront-home], [data-storefront-collection], [data-storefront-discovery]) [data-storefront-reveal] { transition: opacity var(--storefront-transition-normal), transform var(--storefront-transition-normal); }
:is([data-storefront-home], [data-storefront-collection], [data-storefront-discovery]) [data-storefront-reveal=pending] { opacity: 0; transform: translateY(12px); }
:is([data-storefront-home], [data-storefront-collection], [data-storefront-discovery]) [data-storefront-reveal=visible] { opacity: 1; transform: none; }
:is([data-storefront-home], [data-storefront-collection], [data-storefront-discovery]) [data-storefront-reveal]:focus-within { opacity: 1; transform: none; }
[data-storefront-home] :is(.storefront-hero-heading, .storefront-hero-subtitle, .hero-btn) { animation: storefront-entrance 330ms var(--storefront-ease) both; }
[data-storefront-home] .hero-btn { animation-delay: 60ms; }
@keyframes storefront-entrance { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
@keyframes storefront-light-drift { to { transform: translate(2%, 1%); opacity: .65; } }
@media (hover: hover) and (pointer: fine) {
 [data-storefront-home] .catalog-category:hover img { transform: scale(1.025); }
 [data-storefront-home] .catalog-category:hover { transform: translateY(-3px); border-color: #70bac7; box-shadow: var(--storefront-shadow-raised), 0 0 0 1px #aae0e64d; }
 [data-storefront-home] .hero-btn .theme-btn:hover { transform: translateY(-2px); box-shadow: 0 9px 22px #106f7a33, 0 0 0 3px #bde9ed80; }
 [data-storefront-home] .catalog-category:hover { transform: translateY(-3px) scale(1.01); }
 :is(.theme-btn, .theme-btn-2, .theme-btn-4):not(:disabled):hover, fankee-shopping-assistant .shopping-assistant__primary:not(:disabled):hover { box-shadow: 0 4px 12px #13554124; }
 fankee-shopping-assistant .shopping-assistant__launcher:hover { box-shadow: 0 10px 26px rgb(11 79 88 / 28%), 0 0 0 4px var(--fk-cyan-100); transform: translateY(-1px); }
 fankee-shopping-assistant .shopping-assistant__launcher:hover svg { transform: translateX(-2px) rotate(-6deg); }
}
@media (hover: none) {
 .catalog-card:active, [data-storefront-home] .catalog-category:active { border-color: #8cbfc8; }
}
@media (max-width: 599px) {
 #MainContent { background: linear-gradient(180deg, #f1fafb, #fff 800px); }
 #MainContent[data-storefront-home]::before, #MainContent[data-storefront-home]::after, [data-storefront-home] .hero-area::before, [data-storefront-home] .hero-area::after { animation: none; }
 #MainContent[data-storefront-home]::after, [data-storefront-home] .hero-area::after { display: none; }
 .storefront-header { backdrop-filter: none; background: #fffffff5; }
 .catalog-card { box-shadow: 0 2px 8px #21495608; }
}
@media (prefers-reduced-motion: reduce) {
 [data-storefront-home] :is(.storefront-hero-heading, .storefront-hero-subtitle, .hero-btn) { animation: none; }
 [data-storefront-home] .hero-area::before { animation: none; }
 :is([data-storefront-home], [data-storefront-collection], [data-storefront-discovery]) [data-storefront-reveal], :is([data-storefront-home], [data-storefront-collection], [data-storefront-discovery]) [data-storefront-reveal=pending] { opacity: 1; transform: none; transition: none; }
 .catalog-card, .catalog-card__image img, [data-storefront-home] .catalog-category,
 :is(.theme-btn, .theme-btn-2, .theme-btn-4), fankee-shopping-assistant .shopping-assistant__primary, fankee-shopping-assistant .shopping-assistant__launcher { transition: none; }
 .catalog-card:hover, .catalog-card:hover .catalog-card__image img, [data-storefront-home] .catalog-category:hover,
 :is(.theme-btn, .theme-btn-2, .theme-btn-4):active, fankee-shopping-assistant .shopping-assistant__primary:active { transform: none; }
}
html[data-a11y-paused] [data-storefront-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
html[data-a11y-paused] #MainContent::before, html[data-a11y-paused] #MainContent::after, html[data-a11y-paused] [data-storefront-home] .hero-area::before, html[data-a11y-paused] [data-storefront-home] .hero-area::after { animation: none; }
html[data-a11y-paused] [data-storefront-home] :is(.storefront-hero-heading, .storefront-hero-subtitle, .hero-btn) { animation: none; }
@media (prefers-reduced-motion: reduce) {
 #MainContent[data-storefront-home]::before, #MainContent[data-storefront-home]::after, [data-storefront-home] .hero-area::before, [data-storefront-home] .hero-area::after { animation: none; transform: none; }
 [data-storefront-home] .catalog-category:hover img, [data-storefront-home] .hero-btn .theme-btn:is(:hover, :active) { transform: none; }
 [data-storefront-home] .catalog-category img, [data-storefront-home] .hero-btn .theme-btn { transition: none; }
}

/* Responsive proportion polish: the mobile launcher owns space instead of covering cards. */
@media (min-width: 992px) {
 fankee-shopping-assistant { display: block; block-size: 0; }
 .storefront-header .storefront-menu-logo img { max-width: 164px; max-height: 60px; }
 #MainContent[data-storefront-home]::before { height: min(38vw, 430px); opacity: .65; }
 #MainContent[data-storefront-home]::after { height: min(32vw, 380px); opacity: .6; }
}
@media (max-width: 991px) {
 .storefront-header .container-fluid > .row { grid-template-columns: minmax(0, 1fr) auto auto; min-height: 0; padding-block: 4px; gap: 4px 8px; }
 .storefront-header .navbar-brand { grid-column: 1; grid-row: 1; padding: 0; min-width: 0; }
 .storefront-header .storefront-menu-logo img { inline-size: clamp(128px, 22vw, 156px); block-size: 48px; max-width: 100%; max-height: 48px; }
 .storefront-header-tools { display: contents; }
 .storefront-header .row > fankee-predictive-search { grid-column: 1 / -1; grid-row: 2; inline-size: 100%; }
 .storefront-header .row > fankee-predictive-search form[role=search] { width: 100%; min-height: 44px; height: 44px; }
 .storefront-header .mobail-menu { grid-column: 3; grid-row: 1; }
 .storefront-header-tools .mini-cart { grid-column: 2; grid-row: 1; }
 .storefront-header .row:has(.storefront-account) { grid-template-columns: minmax(0, 1fr) auto auto auto; }
 .storefront-header .storefront-account { grid-column: 2; grid-row: 1; }
 .storefront-header .row:has(.storefront-account) .mini-cart { grid-column: 3; }
 .storefront-header .row:has(.storefront-account) .mobail-menu { grid-column: 4; }
 fankee-shopping-assistant { display: block; min-height: 60px; padding: 8px max(16px, env(safe-area-inset-right)) 8px max(16px, env(safe-area-inset-left)); background: linear-gradient(90deg, var(--fk-cyan-50), #f9fdfd); border-block-end: 1px solid var(--fk-border); text-align: start; }
 fankee-shopping-assistant .shopping-assistant__launcher { position: static; inset: auto; display: inline-flex; min-height: 44px; max-width: 100%; padding: 6px 14px; font-size: 13px; line-height: 1.4; box-shadow: 0 2px 8px rgb(11 79 88 / 14%); }
 fankee-shopping-assistant .shopping-assistant__launcher span { overflow-wrap: anywhere; }
 [data-storefront-home] .hero-area { padding-block: 36px; }
 [data-storefront-home] .catalog-home { padding-block: 24px; --grid-gap: 12px; }
 [data-storefront-home] .catalog-home .catalog-section-header { margin-block-end: 12px; padding-block-end: 8px; }
 [data-storefront-home] .catalog-home .catalog-categories { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
}

/* Product-card presentation only; Shopify data and cart submissions remain authoritative. */
.catalog-card, [data-storefront-home] .catalog-home .catalog-card { border: 1px solid var(--fk-border); border-radius: var(--fk-radius-lg); background: var(--fk-surface); box-shadow: var(--fk-shadow-sm); transition: transform 200ms var(--storefront-ease), box-shadow 200ms var(--storefront-ease), border-color 200ms var(--storefront-ease); }
.catalog-card .catalog-card__image, [data-storefront-home] .catalog-home .catalog-card__image { aspect-ratio: 1; background: radial-gradient(circle at 50% 46%, #fff 0 38%, var(--fk-cyan-50) 78%); border-block-end: 1px solid #e8f2f4; }
.catalog-card .catalog-card__image img { inset: 44px 14px 12px; width: calc(100% - 28px); height: calc(100% - 56px); object-fit: contain; object-position: center; transition: transform 260ms var(--fk-ease-out); }
.catalog-card .catalog-card__content, [data-storefront-home] .catalog-home .catalog-card__content { padding: 14px; gap: 0; }
.catalog-card :is(h2,h3) { font-size: 16px; font-weight: 600; line-height: 1.5; height: 3em; margin-block-end: 10px; color: var(--fk-text); }
.catalog-card :is(h2,h3) a { color: inherit; transition: color var(--fk-dur-fast) ease; }
.catalog-card .catalog-price { gap: 4px 10px; margin-block: 0 6px; font-size: 20px; font-weight: 800; letter-spacing: -.01em; color: var(--fk-teal-900); min-height: 30px; align-items: baseline; }
/* A sale price (compare-at present) carries the emphasis colour; the struck price stays quiet. */
.catalog-price:has(s) > bdi { color: var(--fk-danger); }
.catalog-card .catalog-price s { font-size: 13px; color: var(--fk-text-muted); font-weight: 400; text-decoration-thickness: 1px; }
.catalog-card .catalog-card__vendor, .catalog-card .catalog-availability { font-size: 12px; color: var(--fk-text-muted); }
.catalog-card .catalog-availability { display: flex; align-items: center; gap: 6px; }
.catalog-card .catalog-availability::before { content: ''; flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--fk-success); }
.catalog-card--sold-out .catalog-availability::before { background: #9aa8ad; }
/* "Choose options" links are a secondary action so Add to Cart stays the strongest control. */
.catalog-card a.theme-btn, [data-storefront-home] .catalog-home .catalog-card a.theme-btn:not(:disabled) { background: var(--fk-surface); color: var(--fk-accent); border: 1px solid var(--fk-border-strong); box-shadow: none; }
.catalog-card .catalog-availability { margin-block: 4px 12px; }
.catalog-card .theme-btn { inline-size: 100%; min-height: 44px; padding: 9px 8px; border-radius: 10px; white-space: nowrap; font-size: 14px; transition: transform 200ms var(--storefront-ease), background-color 200ms var(--storefront-ease), box-shadow 200ms var(--storefront-ease); }
.catalog-card .theme-btn[aria-busy=true] { cursor: progress; opacity: .8; }
.catalog-card__form[aria-busy=true] { cursor: progress; }
.catalog-card--sold-out .catalog-card__image { background: #f7f9fa; }
.catalog-card--sold-out .catalog-card__image img { opacity: .72; }
.catalog-card--sold-out .catalog-price { color: #53656b; }
.catalog-card--sold-out .theme-btn:disabled { background: #edf1f2; border: 1px solid #d4dfe2; color: #526169; opacity: 1; }
.catalog-card:focus-within { outline: 2px solid #197d8d; outline-offset: 2px; }
@media (hover: hover) and (pointer: fine) {
 .catalog-card:not(.catalog-card--sold-out):hover, [data-storefront-home] .catalog-home .catalog-card:not(.catalog-card--sold-out):hover { transform: translateY(-3px); border-color: var(--fk-border-strong); box-shadow: var(--fk-shadow-md), 0 0 0 1px var(--fk-cyan-100); }
 .catalog-card:not(.catalog-card--sold-out):hover .catalog-card__image img { transform: scale(1.04); }
 .catalog-card:hover :is(h2,h3) a { color: var(--fk-accent); }
 :is(.catalog-card, [data-storefront-home] .catalog-home .catalog-card) a.theme-btn:not(:disabled):hover { background: var(--fk-cyan-50); border-color: var(--fk-accent); color: var(--fk-accent); }
 .catalog-card--sold-out:hover { transform: none; }
}
@media (max-width: 599px) {
 .catalog-card .catalog-card__content, [data-storefront-home] .catalog-home .catalog-card__content { padding: 10px; }
 .catalog-card :is(h2,h3) { font-size: 14px; margin-block-end: 8px; }
 .catalog-card .catalog-price { font-size: 17px; gap: 2px 6px; }
 .catalog-card .theme-btn { font-size: 13px; padding-inline: 5px; letter-spacing: 0; }
}
@media (prefers-reduced-motion: reduce) {
 .catalog-card, [data-storefront-home] .catalog-home .catalog-card, .catalog-card .catalog-card__image img, .catalog-card .theme-btn { transition: none; }
 .catalog-card:not(.catalog-card--sold-out):hover, [data-storefront-home] .catalog-home .catalog-card:not(.catalog-card--sold-out):hover,
 .catalog-card:not(.catalog-card--sold-out):hover .catalog-card__image img { transform: none; }
}

/* Shared quick-add and product-page action: direct text survives existing AJAX labels. */
[data-card-cart] button.theme-btn[name=add] { position: relative; isolation: isolate; overflow: hidden; background: var(--storefront-cart-base); border: 1px solid var(--storefront-cart-base); color: #fff; border-radius: 12px; box-shadow: var(--storefront-cart-shadow); transition: transform 140ms var(--storefront-ease), box-shadow 200ms var(--storefront-ease), background-color 200ms var(--storefront-ease); }
[data-card-cart] button.theme-btn[name=add]::before { content: ''; display: block; position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; border: 0; border-radius: inherit; z-index: -1; pointer-events: none; background: linear-gradient(110deg, var(--storefront-cart-base), var(--storefront-cart-highlight)); opacity: 1; transform: translateX(100%); transition: transform 250ms var(--storefront-ease); }
[data-card-cart] button.theme-btn[name=add]:focus-visible { background: var(--storefront-cart-base); outline: 3px solid var(--storefront-accent); outline-offset: 3px; }
[data-card-cart] button.theme-btn[name=add]:not(:disabled):active { transform: scale(.985); box-shadow: none; }
[data-card-cart] button.theme-btn[name=add]:disabled:not([aria-busy=true]) { background: #edf1f2; border-color: #d4dfe2; color: #526169; box-shadow: none; cursor: not-allowed; opacity: 1; }
[data-card-cart] button.theme-btn[name=add]:disabled::before { transform: translateX(100%); }
[data-card-cart] button.theme-btn[name=add][aria-busy=true] { background: var(--storefront-cart-base); color: #fff; opacity: .8; cursor: progress; }
[data-card-feedback]:not(:empty):not([data-feedback-error]) { padding: 8px 10px; border-radius: 8px; background: #edf8f6; color: #185d53; }
@media (hover: hover) and (pointer: fine) {
 [data-card-cart] button.theme-btn[name=add]:not(:disabled):hover { background: var(--storefront-cart-base); transform: translateY(-1px); box-shadow: 0 7px 18px #0b65712e; }
 [data-card-cart] button.theme-btn[name=add]:not(:disabled):hover::before { transform: translateX(0); }
 [data-card-cart] button.theme-btn[name=add]:not(:disabled):active { transform: scale(.985); }
}
@media (prefers-reduced-motion: reduce) {
 [data-card-cart] button.theme-btn[name=add] { transition: background-color 150ms ease; }
 [data-card-cart] button.theme-btn[name=add]::before { display: none; transition: none; }
 [data-card-cart] button.theme-btn[name=add]:not(:disabled):is(:hover,:active) { transform: none; background: var(--storefront-cart-highlight); }
}
html[data-a11y-paused] [data-card-cart] button.theme-btn[name=add]::before { display: none; }
html[data-a11y-paused] [data-card-cart] button.theme-btn[name=add]:is(:hover,:active) { transform: none; }

/* ===== Fankee UI system (tokens: assets/storefront.css) =====
   Durations use --fk-dur*, which collapse to 0 for reduced motion and the accessibility pause. */

/* Buttons: one teal primary. Legacy style.css paints .theme-btn orange; components that own a treatment
   (Add to Cart, Group Delivery, promo, hero, card secondary) keep it through higher specificity. */
.theme-btn, .theme-btn-2, .theme-btn-4 { background: linear-gradient(120deg, var(--fk-teal-700), var(--fk-teal-600) 50%, var(--fk-teal-700)); background-size: 220% 100%; background-position: 100% 0; color: #fff; border: 1px solid var(--fk-primary); box-shadow: var(--fk-shadow-cta); transition: transform var(--fk-dur-fast) var(--fk-ease), box-shadow var(--fk-dur) var(--fk-ease), background-position var(--fk-dur-slow) var(--fk-ease-out), background-color var(--fk-dur) var(--fk-ease); }
.theme-btn:not(:disabled):is(:hover, :focus-visible), .theme-btn-2:not(:disabled):is(:hover, :focus-visible) { color: #fff; }
/* The legacy theme paints an orange ::before layer on every .theme-btn; components with a sweep set their own. */
.theme-btn::before, .theme-btn-2::before, .theme-btn-4::before { background: transparent; }
@media (hover: hover) and (pointer: fine) {
 .theme-btn:not(:disabled):hover, .theme-btn-2:not(:disabled):hover { background-position: 0 0; box-shadow: 0 10px 22px rgb(11 101 113 / 26%); transform: translateY(-1px); }
}

/* Content links without a component class. Bootstrap's blue never reaches the storefront. */
:where(#MainContent) a:where(:not([class])) { color: var(--fk-accent); text-decoration: underline; text-decoration-color: rgb(8 107 123 / 35%); text-underline-offset: 3px; transition: color var(--fk-dur-fast) ease, text-decoration-color var(--fk-dur-fast) ease; }
:where(#MainContent) a:where(:not([class])):hover { color: var(--fk-teal-900); text-decoration-color: currentColor; }
/* Links that are headings or navigation (card titles, breadcrumbs) keep their component styling. */
:where(#MainContent) :where(h1, h2, h3, h4, h5, h6, nav) a:where(:not([class])) { color: inherit; text-decoration: none; }

/* Form fields: zero-specificity base so every component keeps its own sizing. */
:where(#MainContent, .storefront-footer, fankee-shopping-assistant) :where(input:not([type=checkbox], [type=radio], [type=hidden], [type=range], [type=submit], [type=button], [type=image]), select, textarea) { border-color: var(--fk-border-strong); border-radius: var(--fk-radius-md); transition: border-color var(--fk-dur-fast) ease, box-shadow var(--fk-dur-fast) ease, background-color var(--fk-dur-fast) ease; }
:where(#MainContent, .storefront-footer, fankee-shopping-assistant) :where(input:not([type=checkbox], [type=radio], [type=hidden], [type=range], [type=submit], [type=button], [type=image]), select, textarea):hover { border-color: #7fb9c3; }
:where(#MainContent, .storefront-footer, fankee-shopping-assistant) :where(input:not([type=checkbox], [type=radio], [type=hidden], [type=range], [type=submit], [type=button], [type=image]), select, textarea):focus-visible { border-color: var(--fk-accent); box-shadow: var(--fk-ring); outline: 2px solid var(--fk-accent); outline-offset: 1px; }
:where(#MainContent, .storefront-footer, fankee-shopping-assistant) :where(input, select, textarea)[aria-invalid=true] { border-color: var(--fk-danger); }
:where(#MainContent, .storefront-footer) :where(input[type=checkbox], input[type=radio]) { accent-color: var(--fk-primary); }
:where(#MainContent) .storefront-form-errors { border-inline-start: 3px solid var(--fk-danger); background: var(--fk-danger-bg); border-radius: var(--fk-radius-sm); }

/* Pagination: same chip language as filters; the current page is the one primary element. */
.catalog-pagination { gap: 8px; }
.catalog-pagination a, .catalog-pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 0 14px; border: 1px solid var(--fk-border); border-radius: var(--fk-radius-md); background: var(--fk-surface); color: var(--fk-text); font-weight: 600; text-decoration: none; box-shadow: var(--fk-shadow-sm); transition: background-color var(--fk-dur-fast) ease, border-color var(--fk-dur-fast) ease, color var(--fk-dur-fast) ease, transform var(--fk-dur-fast) ease; }
.catalog-pagination a:hover { border-color: var(--fk-border-strong); background: var(--fk-cyan-50); color: var(--fk-accent); transform: translateY(-1px); }
.catalog-pagination [aria-current] { background: var(--fk-gradient-primary); border-color: var(--fk-primary); color: #fff; box-shadow: var(--fk-shadow-cta); }

/* Filter disclosures (collection and search): custom chevron instead of the browser triangle. */
.catalog-filter summary { display: flex; align-items: center; justify-content: space-between; gap: 10px; list-style: none; }
.catalog-filter summary::-webkit-details-marker { display: none; }
.catalog-filter summary::after { content: ''; flex: 0 0 8px; inline-size: 8px; block-size: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; color: var(--fk-accent); transform: translateY(-2px) rotate(45deg); transition: transform var(--fk-dur) var(--fk-ease-out); }
.catalog-filter[open] > summary::after { transform: translateY(2px) rotate(225deg); }
.catalog-filter[open] > :not(summary) { animation: fk-fade var(--fk-dur) var(--fk-ease-out); }

/* Section headings: a short teal-to-cyan rule gives every product row the same anchor. */
.catalog-section-header h2::after { content: ''; display: block; inline-size: 44px; block-size: 3px; margin-block-start: 10px; border-radius: 3px; background: linear-gradient(90deg, var(--fk-highlight), var(--fk-primary)); }
:dir(ltr) .catalog-section-header h2::after { background: linear-gradient(90deg, var(--fk-primary), var(--fk-highlight)); }
.catalog-section-header__link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--fk-accent); font-weight: 600; text-decoration: none; }
.catalog-section-header__link::after { content: '←'; transition: transform var(--fk-dur) var(--fk-ease-out); }
:dir(ltr) .catalog-section-header__link::after { content: '→'; }
@media (hover: hover) and (pointer: fine) {
 .catalog-section-header__link:hover::after { transform: translateX(-4px); }
 :dir(ltr) .catalog-section-header__link:hover::after { transform: translateX(4px); }
}

/* Homepage rhythm: every other product/category row sits on a faint full-width cyan band. */
[data-storefront-home] > .shopify-section:has(> .catalog-home):nth-of-type(even) { background: linear-gradient(180deg, transparent, rgb(223 245 247 / 55%) 18%, rgb(223 245 247 / 55%) 82%, transparent); }

/* Header: glass surface with a soft edge, animated nav indicator, branded badge and search depth. */
.storefront-header { box-shadow: inset 0 -1px 0 rgb(255 255 255 / 60%), 0 4px 18px rgb(11 79 88 / 6%); }
.storefront-header .cart-count { background: var(--fk-gradient-primary); color: #fff; box-shadow: 0 0 0 2px #fff, 0 2px 6px rgb(11 79 88 / 25%); }
.storefront-header .cart-count[data-bump] { animation: fk-bump calc(460ms * var(--fk-motion-scale)) var(--fk-ease-out); }
@media (prefers-reduced-motion: reduce) { .storefront-header .cart-count[data-bump] { animation: none; } }
html[data-a11y-paused] .storefront-header .cart-count[data-bump] { animation: none; }
.storefront-header form[role=search] { background: #fff; border-color: var(--fk-border); border-radius: var(--fk-radius-md); box-shadow: inset 0 1px 2px rgb(11 79 88 / 6%), var(--fk-shadow-sm); transition: border-color var(--fk-dur-fast) ease, box-shadow var(--fk-dur-fast) ease; }
.storefront-header form[role=search]:focus-within { border-color: var(--fk-accent); box-shadow: var(--fk-ring); }
.storefront-header fankee-predictive-search input { background: transparent; }
.storefront-header .nav-mega-panel:not([hidden]) { animation: fk-drop var(--fk-dur) var(--fk-ease-out); box-shadow: var(--fk-shadow-lg); border-color: var(--fk-border); }
@media (min-width: 992px) {
 .storefront-header #navbar > ul > li > a, .storefront-header .nav-mega-trigger { position: relative; }
 .storefront-header #navbar > ul > li > a::after, .storefront-header .nav-mega-trigger::after { content: ''; position: absolute; inset-inline: 2px; inset-block-end: 4px; block-size: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--fk-highlight), var(--fk-primary)); transform: scaleX(0); transition: transform var(--fk-dur) var(--fk-ease-out); }
 .storefront-header #navbar > ul > li > a:is(:hover, :focus-visible, [aria-current=page])::after, .storefront-header .nav-mega-trigger:is(:hover, :focus-visible, .is-active, [aria-expanded=true])::after { transform: scaleX(1); }
 .storefront-header #navbar > ul > li > a:hover { color: var(--fk-accent); }
}

@media (max-width: 991px) {
 .storefront-header #navbar { background: linear-gradient(170deg, var(--fk-teal-800), var(--fk-teal-950)); transition: inset-inline-start var(--fk-dur-slow) var(--fk-ease-out), box-shadow var(--fk-dur-slow) ease; }
 .storefront-header #navbar.slideInn { box-shadow: 0 0 0 100vmax rgb(7 46 53 / 38%), var(--fk-shadow-lg); }
 .storefront-header .cart-toggle-btn, .storefront-header .open-btn { border-radius: var(--fk-radius-md); }
}

/* Inventory messages (tone set by storefront.js): low stock warns, purchase limits inform, sold out is quiet. */
.inventory-limit[data-tone]:not(:empty) { display: flex; align-items: center; gap: 6px; inline-size: fit-content; max-inline-size: 100%; padding: 4px 10px; border-radius: var(--fk-radius-md); font-size: 12px; font-weight: 600; line-height: 1.5; animation: fk-fade var(--fk-dur) var(--fk-ease-out); }
.inventory-limit[data-tone]:not(:empty)::before { content: ''; flex: 0 0 6px; inline-size: 6px; block-size: 6px; border-radius: 50%; background: currentColor; }
.inventory-limit[data-tone=low] { background: var(--fk-warning-bg); color: var(--fk-warning); }
.inventory-limit[data-tone=limit] { background: var(--fk-cyan-50); color: var(--fk-accent); }
.inventory-limit[data-tone=out] { background: var(--fk-surface-muted); color: var(--fk-text-muted); }

/* Reveal stagger: storefront-motion.js sets --fk-reveal-delay per grid item, then clears it. */
:is([data-storefront-home], [data-storefront-collection], [data-storefront-discovery]) [data-storefront-reveal] { transition-delay: var(--fk-reveal-delay, 0ms); }

@keyframes fk-drop { from { opacity: 0; translate: 0 -6px; } }
@keyframes fk-rise { from { opacity: 0; translate: 0 10px; } }
@keyframes fk-fade { from { opacity: 0; } }
@keyframes fk-bump { 30% { transform: scale(1.35); } 60% { transform: scale(.92); } }
@media (prefers-reduced-motion: reduce) {
 .theme-btn, .theme-btn-2, .theme-btn-4, .catalog-pagination a { transition: none; }
 .theme-btn:not(:disabled):hover, .catalog-pagination a:hover { transform: none; }
}
html[data-a11y-paused] :is(.theme-btn, .theme-btn-2, .theme-btn-4, .catalog-pagination a):hover { transform: none; }
{% endstylesheet %}

