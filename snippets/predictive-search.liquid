{% doc %}
  Header product search with a progressively enhanced suggestions dropdown.
  @param {string} search_id - Unique ID derived from the header section.
  @example
  {% render 'predictive-search', search_id: 'HeaderSearch-header' %}
{% enddoc %}
<fankee-predictive-search
  data-search-url="{{ routes.search_url }}"
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-loading-label="{{ 'storefront.predictive.loading' | t | escape }}"
  data-error-label="{{ 'storefront.predictive.error' | t | escape }}"
  data-empty-label="{{ 'storefront.predictive.empty' | t | escape }}"
  data-count-label="{{ 'storefront.predictive.count' | t: count: '__COUNT__' | escape }}"
>
  <form method="get" action="{{ routes.search_url }}" role="search">
    <label class="sr-only" for="{{ search_id }}">{{ 'general.search.search' | t }}</label>
    <input type="search" id="{{ search_id }}" name="q" placeholder="{{ 'storefront.search_placeholder' | t }}" value="{{ search.terms | escape }}">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" aria-label="{{ 'general.search.search' | t | escape }}"><i class="ti-search" aria-hidden="true"></i></button>
  </form>
  <div class="predictive-search__panel" data-search-panel hidden>
    <div class="predictive-search__loading" data-search-loading hidden aria-hidden="true"><span class="predictive-search__spinner"></span>{{ 'storefront.predictive.loading' | t }}</div>
    <div data-search-results></div>
    <a class="predictive-search__all" data-search-all href="{{ routes.search_url }}?type=product">{{ 'storefront.predictive.all' | t }}</a>
  </div>
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-search-status></p>
</fankee-predictive-search>
{% render 'predictive-search-styles' %}
