{% doc %}
  A row of subcategory chips: wraps on desktop, scrolls sideways on phones. Empty collections are skipped, except the
  current one. Prints nothing when no subcategory would be shown. The chips are links to the collections; inside a
  [data-subcategory-root] section, assets/subcategory-filter.js shows their products in place instead.

  @param chips - Collections to show (a collection_list setting).
  @param {string} chips_label - Accessible name of the list.
  @param {collection} chips_parent - The whole category, shown first as "all products".
  @param {string} chips_current - Handle of the collection whose products are shown.
  @example
  {% render 'category-chips', chips: section.settings.subcategories, chips_label: label, chips_parent: collection, chips_current: collection.handle %}
{% enddoc %}
{%- capture chip_items -%}
  {%- for chip in chips -%}
    {%- if chip.products_count > 0 or chip.handle == chips_current -%}
      <li><a class="category-chip" href="{{ chip.url }}" data-subcategory="{{ chip.title | escape }}"{% if chip.handle == chips_current %} aria-current="page"{% endif %}>{{ chip.title | escape }}</a></li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if chip_items != blank -%}
  <ul class="category-chips" role="list" aria-label="{{ chips_label | strip | escape_once }}">
    <li><a class="category-chip" href="{{ chips_parent.url }}" data-subcategory="{{ chips_parent.title | escape }}" aria-label="{{ 'collection_page.all_label' | t: collection_name: chips_parent.title | escape_once }}"{% if chips_parent.handle == chips_current %} aria-current="page"{% endif %}>{{ 'collection_page.all' | t }}</a></li>
    {{- chip_items -}}
  </ul>
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-subcategory-status data-loading="{{ 'collection_page.loading' | t | escape }}" data-loaded="{{ 'collection_page.loaded' | t: collection_name: '__NAME__' | escape }}" data-more="{{ 'collection_page.show_more' | t | escape }}" data-more-one="{{ 'sections.featured_collection.more_products' | t: count: 1 | escape }}" data-more-other="{{ 'sections.featured_collection.more_products.other' | t: count: '__COUNT__' | escape }}"></p>
  <div class="subcategory-error" role="alert" data-subcategory-error hidden><span>{{ 'collection_page.load_error' | t }}</span> <button type="button" data-subcategory-retry>{{ 'collection_page.retry' | t }}</button></div>
{%- endif -%}

{% stylesheet %}
.category-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
.category-chips li { margin: 0; flex: 0 0 auto; }
.category-chip { display: inline-flex; align-items: center; min-height: 44px; padding: 6px 16px; border: 1px solid var(--fk-border); border-radius: 999px; background: #fff; color: var(--fk-accent); font-size: 14px; font-weight: 600; line-height: 1.4; text-decoration: none; white-space: nowrap; }
.category-chip:is(:hover, :focus-visible) { border-color: var(--fk-border-strong); background: var(--fk-cyan-50); color: var(--fk-teal-900); }
.category-chip:focus-visible { outline: 2px solid var(--fk-accent); outline-offset: 2px; }
.category-chip:is([aria-current], [aria-pressed=true]) { border-color: var(--fk-primary); background: var(--fk-primary); color: #fff; }
.catalog-home > .category-chips { margin-block-end: 16px; }
[data-subcategory-root] { position: relative; }
[data-subcategory-results] { min-width: 0; scroll-margin-block-start: 140px; }
[data-subcategory-results][aria-busy=true] { opacity: .5; pointer-events: none; transition: opacity var(--fk-dur-fast, 150ms) ease; }
.subcategory-error { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-block-end: 16px; padding: 10px 14px; border: 1px solid #efb9c6; border-radius: var(--fk-radius-md, 12px); background: var(--fk-danger-bg); color: var(--fk-danger); font-size: 14px; }
.subcategory-error[hidden] { display: none; }
.subcategory-error button { min-height: 44px; padding: 6px 16px; border: 1px solid currentcolor; border-radius: 999px; background: #fff; color: inherit; font: inherit; font-weight: 600; }
@media (max-width: 600px) {
 .category-chips { flex-wrap: nowrap; overflow-x: auto; overscroll-behavior-inline: contain; margin-inline: -4px; padding: 4px; scrollbar-width: none; }
 .category-chips::-webkit-scrollbar { display: none; }
}
@media (prefers-reduced-motion: reduce) { [data-subcategory-results][aria-busy=true] { transition: none; } }
{% endstylesheet %}
