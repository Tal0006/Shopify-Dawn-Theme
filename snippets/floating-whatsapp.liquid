{% doc %}
  Floating WhatsApp chat button. The number comes from Theme Settings (international format, digits only, e.g.
  972501234567); nothing renders when the button is disabled or the number is not 8-15 digits. It sits in the
  bottom inline-start corner, opposite the accessibility and shopping-assistant launchers (inline-end), and hides
  while any modal dialog (cart drawer, accessibility panel, back-in-stock form) is open.
  @example
  {% render 'floating-whatsapp' %}
{% enddoc %}
{%- capture wa_digits -%}{% render 'whatsapp-number' %}{%- endcapture -%}
{%- liquid
  assign wa_digits = wa_digits | strip
  assign wa_show = false
  if settings.floating_whatsapp_enabled and wa_digits != blank
    assign wa_show = true
  endif
-%}
{%- if wa_show -%}
<a class="floating-whatsapp" href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'floating_whatsapp.label' | t: shop: shop.name | escape }} ({{ 'google_review.new_tab' | t | escape }})">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.2a9.7 9.7 0 0 0-8.3 14.7L2.3 21.8l5-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7c-1.5 0-2.9-.4-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3a8 8 0 1 1 6.9 3.7Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.5 4 3.5 1.5.6 2.1.7 2.8.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.2Z"/></svg>
</a>
{%- endif -%}
{% stylesheet %}
.floating-whatsapp { position: fixed; z-index: 1000000; inset-block-end: max(16px, env(safe-area-inset-bottom)); inset-inline-start: 16px; display: grid; place-items: center; inline-size: 52px; block-size: 52px; border: 2px solid #fff; border-radius: 50%; background: #1b8e4b; color: #fff; box-shadow: 0 6px 18px rgb(7 46 53 / 24%); transition: transform var(--fk-dur-fast, 160ms) var(--fk-ease, ease), box-shadow var(--fk-dur, 240ms) ease; }
.floating-whatsapp:focus-visible { outline: 3px solid var(--fk-teal-800, #0b4f58) !important; outline-offset: 3px !important; }
@media (hover: hover) and (pointer: fine) { .floating-whatsapp:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgb(7 46 53 / 30%); } }
/* Never above or next to an open modal (cart drawer, accessibility panel, dialogs). */
html:has(dialog[open]) .floating-whatsapp, html:has(.a11y-panel:not([hidden])) .floating-whatsapp { visibility: hidden; }
/* Keep the last footer row clear of the button at the end of the page. */
html:has(.floating-whatsapp) .storefront-footer__bottom { padding-inline-start: 72px; }
@media (prefers-reduced-motion: reduce) { .floating-whatsapp { transition: none; } .floating-whatsapp:hover { transform: none; } }
html[data-a11y-paused] .floating-whatsapp { transition: none; }
html[data-a11y-paused] .floating-whatsapp:hover { transform: none; }
{% endstylesheet %}
