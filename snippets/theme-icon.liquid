{% stylesheet %}
.theme-icon { display: inline-block; inline-size: 1em; block-size: 1em; line-height: 1; vertical-align: -0.0625em; }
.theme-icon > svg { display: block; inline-size: 100%; block-size: 100%; }
{% endstylesheet %}
