{% stylesheet %}
  fankee-predictive-search { display: block; position: relative; min-inline-size: 0; text-align: start; }
  .predictive-search__panel[hidden], .predictive-search__loading[hidden] { display: none; }
  .predictive-search__panel { position: absolute; inset-block-start: calc(100% + 8px); inset-inline-end: 0; z-index: 65; inline-size: min(420px, calc(100vw - 32px)); max-block-size: min(480px, var(--predictive-available-height, 60dvh)); overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--storefront-border); border-radius: var(--storefront-radius); background: #fff; color: var(--storefront-ink); box-shadow: 0 8px 24px #182b251a; font-size: 14px; }
  .predictive-search__list { list-style: none; margin: 0; padding: 4px; }
  .predictive-search__option { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: var(--space-sm); align-items: center; min-block-size: 76px; padding: 8px; color: inherit; text-align: start; border-radius: 6px; }
  .predictive-search__option:hover, .predictive-search__option[aria-selected=true] { background: #f0f5f1; color: var(--storefront-green); }
  .predictive-search__option:focus-visible, .predictive-search__all:focus-visible { outline: 3px solid #c76600; outline-offset: -3px; }
  .predictive-search__image { display: flex; align-items: center; justify-content: center; inline-size: 54px; block-size: 60px; background: #f6f8f6; border-radius: 5px; overflow: hidden; }
  .predictive-search__image img { inline-size: 54px; block-size: 60px; object-fit: contain; }
  .predictive-search__title { display: block; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .predictive-search__meta { display: block; color: #506259; font-size: 12px; line-height: 1.4; }
  .predictive-search__option .catalog-price { font-size: 14px; gap: 8px; line-height: 1.5; }
  .predictive-search__option .catalog-price small { display: none; }
  .predictive-search__all { display: block; position: sticky; inset-block-end: 0; min-block-size: 44px; padding: 10px 16px; border-block-start: 1px solid var(--storefront-border); background: #fff; color: var(--storefront-green); font-weight: 600; text-align: center; }
  .predictive-search__empty, .predictive-search__loading { margin: 0; padding: 16px; min-block-size: 76px; }
  .predictive-search__empty small { display: block; font-size: 13px; color: #506259; }
  .predictive-search__loading { display: flex; align-items: center; gap: 10px; }
  .predictive-search__spinner { inline-size: 16px; block-size: 16px; border: 2px solid var(--storefront-border); border-block-start-color: var(--storefront-green); border-radius: 50%; animation: predictive-spin .8s linear infinite; }
  @keyframes predictive-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .predictive-search__spinner { animation: none; } }
  @media (max-width: 575px) {
    .storefront-header-tools > fankee-predictive-search { grid-column: 1 / -1; grid-row: 2; inline-size: 100%; }
    .storefront-header-tools fankee-predictive-search form[role=search] { min-block-size: 44px; }
    .predictive-search__panel { inline-size: 100%; }
  }
{% endstylesheet %}
