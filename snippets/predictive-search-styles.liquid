{% stylesheet %}
  fankee-predictive-search { display: block; position: relative; min-inline-size: 0; text-align: start; }
  .predictive-search__panel[hidden], .predictive-search__loading[hidden] { display: none; }
  .predictive-search__panel { position: absolute; inset-block-start: calc(100% + 8px); inset-inline-end: 0; z-index: 65; inline-size: min(420px, calc(100vw - 32px)); max-block-size: min(480px, var(--predictive-available-height, 60dvh)); overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--storefront-border); border-radius: var(--storefront-radius); background: #fff; color: var(--storefront-ink); box-shadow: 0 8px 24px #182b251a; font-size: 14px; }
  .predictive-search__list { list-style: none; margin: 0; padding: 4px; }
  .predictive-search__option { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: var(--space-sm); align-items: center; min-block-size: 76px; padding: 8px; color: inherit; text-align: start; border-radius: 6px; }
  .predictive-search__option:hover, .predictive-search__option[aria-selected=true] { background: #f0f5f1; color: var(--storefront-green); }
  .predictive-search__option:focus-visible, .predictive-search__all:focus-visible { outline: 3px solid #c76600; outline-offset: -3px; }
  .predictive-search__image { display: flex; align-items: center; justify-content: center; inline-size: 54px; block-size: 60px; background: #f6f8f6; border-radius: 5px; overflow: hidden; }
  .predictive-search__image img { inline-size: 54px; block-size: 60px; object-fit: contain; }
  .predictive-search__title { display: block; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .predictive-search__meta { display: block; color: #506259; font-size: 12px; line-height: 1.4; }
  .predictive-search__option .catalog-price { font-size: 14px; gap: 8px; line-height: 1.5; }
  .predictive-search__option .catalog-price small { display: none; }
  .predictive-search__all { display: block; position: sticky; inset-block-end: 0; min-block-size: 44px; padding: 10px 16px; border-block-start: 1px solid var(--storefront-border); background: #fff; color: var(--storefront-green); font-weight: 600; text-align: center; }
  .predictive-search__empty, .predictive-search__loading { margin: 0; padding: 16px; min-block-size: 76px; }
  .predictive-search__empty small { display: block; font-size: 13px; color: #506259; }
  .predictive-search__loading { display: flex; align-items: center; gap: 10px; }
  .predictive-search__spinner { inline-size: 16px; block-size: 16px; border: 2px solid var(--storefront-border); border-block-start-color: var(--storefront-green); border-radius: 50%; animation: predictive-spin .8s linear infinite; }
  @keyframes predictive-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .predictive-search__spinner { animation: none; } }
  @media (max-width: 575px) {
    .storefront-header-tools > fankee-predictive-search { grid-column: 1 / -1; grid-row: 2; inline-size: 100%; }
    .storefront-header-tools fankee-predictive-search form[role=search] { min-block-size: 44px; }
    .predictive-search__panel { inline-size: 100%; }
  }

  .predictive-search__panel { box-sizing: border-box; max-inline-size: 100%; border-color: var(--storefront-border-soft, #cfe4e8); border-radius: 16px; background: #fffffffa; box-shadow: 0 12px 32px #164c6026; animation: predictive-open 180ms var(--storefront-ease, ease-out); }
  .predictive-search__heading { margin: 0; padding: 12px 14px 4px; font-size: 13px; line-height: 1.5; font-weight: 600; color: var(--storefront-accent, #086b7b); }
  .predictive-search__list { padding: 4px 6px 6px; }
  .predictive-search__option { gap: 10px; padding: 10px 8px; border-radius: 10px; transition: background-color 160ms ease, color 160ms ease; }
  .predictive-search__option:hover, .predictive-search__option[aria-selected=true] { background: #eaf7f9; color: var(--storefront-ink); }
  .predictive-search__option:focus-visible, .predictive-search__all:focus-visible { outline-color: var(--storefront-accent, #086b7b); }
  .predictive-search__image { box-sizing: border-box; background: #f3f9fa; border: 1px solid #e5eff2; border-radius: 9px; }
  .predictive-search__image img { inline-size: 100%; block-size: 100%; object-fit: contain; }
  .predictive-search__content { min-width: 0; }
  .predictive-search__title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 14px; }
  .predictive-search__meta { color: #536975; }
  .predictive-search__option .catalog-price { display: flex; flex-wrap: wrap; align-items: baseline; margin-block: 3px; font-size: 15px; font-weight: 600; }
  .predictive-search__option .catalog-price s { color: #657680; font-size: 12px; font-weight: 400; }
  .predictive-search__option .catalog-card__badges { display: none; position: static; min-height: 0; margin-block-start: 3px; gap: 4px; }
  .predictive-search__option .catalog-card__badges:has(> span) { display: flex; flex-wrap: wrap; }
  .predictive-search__option .catalog-card__badge { display: inline-flex; padding: 2px 7px; border-radius: 20px; color: #095564; background: #e7f5f6; font-size: 11px; font-weight: 600; line-height: 1.4; }
  .predictive-search__option .catalog-card__badge--sale { color: #fff; background: #a6314d; }
  .predictive-search__option .catalog-card__badge--quiet { color: #49555d; background: #e9edf0; }
  .predictive-search__option--unavailable .predictive-search__image { opacity: .65; }
  .predictive-search__option--unavailable .predictive-search__title { color: #536975; }
  .predictive-search__option--collection { grid-template-columns: minmax(0, 1fr); min-block-size: 44px; font-weight: 500; }
  .predictive-search__all { border-color: var(--storefront-border-soft, #cfe4e8); background: #f5fbfc; color: var(--storefront-accent, #086b7b); }
  .predictive-search__empty { line-height: 1.6; font-weight: 500; }
  .predictive-search__empty small { margin-block-start: 4px; font-weight: 400; }
  .predictive-search__spinner { border-block-start-color: var(--storefront-accent, #086b7b); }
  .storefront-header fankee-predictive-search form[role=search] { transition: border-color 180ms ease, box-shadow 180ms ease; }
  .storefront-header fankee-predictive-search form[role=search]:focus-within { border-color: var(--storefront-accent, #086b7b); box-shadow: var(--storefront-glow, 0 0 0 3px #0ba7b51a); }
  .storefront-header fankee-predictive-search button { flex-shrink: 0; }
  .storefront-header fankee-predictive-search .predictive-search__clear[hidden] { display: none; }
  .predictive-search__clear:focus-visible { outline: 2px solid var(--storefront-accent, #086b7b); outline-offset: -3px; border-radius: 8px; }
  fankee-predictive-search[data-search-enhanced] input::-webkit-search-cancel-button { -webkit-appearance: none; }
  @keyframes predictive-open { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 767px) {
    .predictive-search__panel { border-radius: 12px; }
    .predictive-search__option { min-block-size: 88px; }
    .predictive-search__option--collection { min-block-size: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .predictive-search__panel { animation: none; }
    .predictive-search__option, .storefront-header fankee-predictive-search form[role=search] { transition: none; }
  }
  /* Panel drops in; fresh results fade in; the active option reads clearly from keyboard and pointer. */
  .predictive-search__panel:not([hidden]) { animation: fk-drop var(--fk-dur-fast) var(--fk-ease-out); border-color: var(--fk-border); box-shadow: var(--fk-shadow-lg); }
  .predictive-search__groups { animation: fk-fade var(--fk-dur) var(--fk-ease-out); }
  .predictive-search__option[aria-selected=true] { background: var(--fk-cyan-50); box-shadow: inset 0 0 0 1px #bfe3e8; }
  .predictive-search__option:hover .predictive-search__title { color: var(--fk-accent); }
  .predictive-search__heading { letter-spacing: .02em; text-transform: none; }
  .predictive-search__all { color: var(--fk-accent); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .predictive-search__panel:not([hidden]), .predictive-search__groups { animation: none; } }
{% endstylesheet %}
