<!doctype html>
<html
  class="js"
  {% if settings.sticky_header %}data-sticky-header{% endif %}
  lang="{{ request.locale.iso_code }}"
  dir="{% if request.locale.iso_code == 'he' or request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}"
  {%- comment -%}
    Diagnostics only (never displayed, no personal data): which theme revision rendered this page and when. Together with
    Shopify.theme.id / Shopify.theme.role in the console, this tells an old tab snapshot or a preview theme apart from
    the live theme. Update the revision with: node tests/helpers/theme-revision.cjs --write
  {%- endcomment %}
  data-theme-revision="{%- render 'theme-revision' -%}"
  data-rendered-at="{{ 'now' | date: '%Y-%m-%dT%H:%M:%S%z' }}"
>
  <head>
    <meta name="google-site-verification" content="JkrR2_njxj9bpVvv9wEM1ox8tUfhSNK6E8guHQt3jqQ" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0b6571">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'storefront.tagged' | t: tags: current_tags }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'storefront.page_title' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {%- if request.page_type == 'product' and product -%}
      {% render 'product-structured-data', sd_product: product %}
    {%- endif -%}
    {%- if request.page_type == 'product' or request.page_type == 'collection' -%}
      {% render 'breadcrumb-structured-data' %}
    {%- endif -%}
    {%- if request.page_type == 'index' -%}
      {% render 'business-structured-data' %}
    {%- endif -%}

    {%- comment -%}
      Render-blocking CSS, in cascade order: theme.css (Bootstrap subset + legacy styles), storefront.css (shared with
      the password and gift card pages) and, below, the small blocking part of the accessibility layer.
    {%- endcomment -%}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'storefront.css' | asset_url | stylesheet_tag }}
    {% render 'storefront-design' %}
    {% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'product' %}
      <script src="{{ 'storefront-motion.js' | asset_url }}" defer></script>
    {% endif %}
    {% if request.page_type == 'customers/account'
      or request.page_type == 'customers/login'
      or request.page_type contains 'customers/'
    -%}
      {{- 'base.css' | asset_url | stylesheet_tag -}}
    {%- endif %}
    <script>
      window.themeStrings = {required: {{ 'storefront.required' | t | json }}, invalidEmail: {{ 'storefront.invalid_email' | t | json }}, quantityError: {{ 'storefront.quantity_error' | t | json }}, backToTop: {{ 'storefront.back_to_top' | t | json }}};
    </script>
    {% render 'cart-submit-guard' %}
    <script src="{{ 'storefront.js' | asset_url }}" defer></script>
    {{ 'accessibility.css' | asset_url | stylesheet_tag }}
    {%- comment -%}
      Accessibility panel and preference modes: loaded without blocking first paint (media switches from print to all
      once it arrives). Its cascade position is this element's position (right after accessibility.css), so the rule
      order is unchanged.
    {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'accessibility-panel.css' | asset_url }}" media="print" onload="this.onload=null;this.media='all'">
    <noscript>{{ 'accessibility-panel.css' | asset_url | stylesheet_tag }}</noscript>
    <script src="{{ 'accessibility.js' | asset_url }}" defer></script>
    {{ content_for_header }}

    {% comment %}
      <script>
        if (window.location.pathname !== '/') {
          window.location.href = '/';
        }
      </script>
    {% endcomment %}
  </head>

  <body class="">
    <a class="a11y-skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    <div class="page-wrapper">
      <!-- Start header -->

      {% render 'announcement-bar' %}
      {% section 'header' %}
      {% if settings.shopping_assistant_enabled %}{% render 'shopping-assistant' %}{% endif %}

      <main
        id="MainContent"
        tabindex="-1"
        {% if request.page_type == 'index' %}
          data-storefront-home
        {% endif %}
      >
        {{ content_for_layout }}
      </main>

      {% section 'footer' %}
      {% render 'back-in-stock' %}
      {% render 'floating-whatsapp' %}
      {% render 'cart-toast' %}
    </div>
    {% render 'accessibility-menu' %}
  </body>
</html>
