<!doctype html>
<html
  class="js"
  lang="{{ request.locale.iso_code }}"
  dir="{% if request.locale.iso_code == 'he' or request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}"
>
  <head>
    <meta name="google-site-verification" content="JkrR2_njxj9bpVvv9wEM1ox8tUfhSNK6E8guHQt3jqQ" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0b6571">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'storefront.tagged' | t: tags: current_tags }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'storefront.page_title' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {%- if request.page_type == 'product' and product -%}
      {% render 'product-structured-data', sd_product: product %}
    {%- endif -%}
    {%- if request.page_type == 'product' or request.page_type == 'collection' -%}
      {% render 'breadcrumb-structured-data' %}
    {%- endif -%}
    {%- if request.page_type == 'index' -%}
      {% render 'business-structured-data' %}
    {%- endif -%}

    <link href="{{ 'bootstrap.min.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'animate.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'themify-icons.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'style.css' | asset_url }}" rel="stylesheet">
    <noscript>
      <style>
        .preloader {
          display: none !important;
        }
      </style>
    </noscript>

    {{ 'storefront.css' | asset_url | stylesheet_tag }}
    {% render 'storefront-design' %}
    {% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'product' %}
      <script src="{{ 'storefront-motion.js' | asset_url }}" defer></script>
    {% endif %}
    {% if request.page_type == 'customers/account'
      or request.page_type == 'customers/login'
      or request.page_type contains 'customers/'
    -%}
      {{- 'base.css' | asset_url | stylesheet_tag -}}
    {%- endif %}
    <script>
      window.themeStrings = {quantityIncrease: {{ 'products.product.quantity.increase' | t: product: product.title | json }}, quantityDecrease: {{ 'products.product.quantity.decrease' | t: product: product.title | json }}, required: {{ 'storefront.required' | t | json }}, invalidEmail: {{ 'storefront.invalid_email' | t | json }}, quantityError: {{ 'storefront.quantity_error' | t | json }}, backToTop: {{ 'storefront.back_to_top' | t | json }}, previousSlide: {{ 'general.slider.previous_slide' | t | json }}, nextSlide: {{ 'general.slider.next_slide' | t | json }}};
    </script>
    {% render 'cart-submit-guard' %}
    <script src="{{ 'storefront.js' | asset_url }}" defer></script>
    {{ 'accessibility.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'accessibility.js' | asset_url }}" defer></script>
    {{ content_for_header }}

    {% comment %}
      <script>
        if (window.location.pathname !== '/') {
          window.location.href = '/';
        }
      </script>
    {% endcomment %}
  </head>

  <body class="">
    <a class="a11y-skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    <div class="page-wrapper">
      <!-- start preloader -->
      <div class="preloader">
        <div class="vertical-centered-box">
          <div class="content">
            <div class="loader-circle"></div>
            <div class="loader-line-mask">
              <div class="loader-line"></div>
            </div>
            <img src="{{ 'preloader.png' | asset_url }}" width="170" height="147" alt="" aria-hidden="true" fetchpriority="low">
          </div>
        </div>
      </div>
      <script>
        (() => {
          // Critical visibility path: plain JavaScript, independent of jQuery and the deferred legacy scripts.
          // style.css also fades the overlay out on its own after a few seconds if this never runs.
          const preloader = document.querySelector('.preloader');
          if (!preloader) return;
          let release;
          window.fankeePreloader = {
            done: new Promise((resolve) => {
              release = resolve;
            }),
          };
          let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          try {
            paused = paused || JSON.parse(localStorage.getItem('punky-accessibility-v1'))?.motion === true;
          } catch {}
          let finished = false;
          const finish = () => {
            if (finished) return;
            finished = true;
            preloader.setAttribute('data-preloader-done', '');
            setTimeout(
              () => {
                preloader.hidden = true;
                release();
              },
              paused ? 0 : 500
            );
          };
          if (paused) {
            finish();
            return;
          }
          // Never waits for images, fonts or legacy scripts: the overlay lifts as soon as the HTML is parsed.
          if (document.readyState !== 'loading') finish();
          else document.addEventListener('DOMContentLoaded', finish, { once: true });
        })();
      </script>
      <!-- end preloader -->
      <!-- Start header -->

      {% render 'announcement-bar' %}
      {% section 'header' %}
      {% if settings.shopping_assistant_enabled %}{% render 'shopping-assistant' %}{% endif %}

      <main
        id="MainContent"
        tabindex="-1"
        {% if request.page_type == 'index' %}
          data-storefront-home
        {% endif %}
      >
        {{ content_for_layout }}
      </main>

      {% section 'footer' %}
      {% render 'back-in-stock' %}
      {% render 'floating-whatsapp' %}
      {% render 'cart-toast' %}
    </div>
    {% render 'accessibility-menu' %}

    <script src="{{ 'jquery.min.js' | asset_url }}" defer></script>
    <script src="{{ 'bootstrap.bundle.min.js' | asset_url }}" defer></script>
    <script src="{{ 'jquery-plugin-collection.js' | asset_url }}" defer></script>
    <script src="{{ 'script.js' | asset_url }}" defer></script>
  </body>
</html>
