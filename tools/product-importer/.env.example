# Required admin login (use a unique password of at least 12 characters).
IMPORTER_USERNAME=
IMPORTER_PASSWORD=
# Local origin defaults to http://127.0.0.1:4310. On Render, RENDER_EXTERNAL_URL is automatic.
# Set APP_ORIGIN to the HTTPS origin if using a custom domain.
APP_ORIGIN=
NODE_ENV=

CHEAPERSAL_API_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Or use client credentials for an installed app in your own Shopify organization:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
PORT=
# Enable only after checking the store's inventory workflow; quantities are never set.
SHOPIFY_TRACK_INVENTORY=

# Automatic chain; use none to disable automatic image lookup.
PRODUCT_IMAGE_PROVIDER=
PRODUCT_IMAGE_API_KEY=
# Optional fallback (also used by authorized-api): HTTPS URL with {barcode}.
PRODUCT_IMAGE_API_URL=

# Paid APIs are skipped when their keys are blank.
BARCODE_LOOKUP_API_KEY=
GO_UPC_API_KEY=
# Search results require manual selection. Enable only with an authorized SerpAPI account.
GOOGLE_IMAGE_PROVIDER=
SERPAPI_API_KEY=
# Blank uses this default order:
PRODUCT_IMAGE_PROVIDER_ORDER=
# Optional comma-separated verified manufacturer/brand domains, used only to rank search suggestions.
PRODUCT_IMAGE_PREFERRED_DOMAINS=

# Explicit Google Images localization; independent of the server/proxy location.
SERPAPI_GL=
SERPAPI_HL=
SERPAPI_LOCATION=
# Set NODE_ENV=development locally to log sanitized query/count diagnostics.
