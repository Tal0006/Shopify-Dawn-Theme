PORT=4330
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:4330
STOREFRONT_ORIGINS=
TRUST_PROXY_HOPS=0
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
STANDARD_DELIVERY_RADIUS_KM=20
GROUP_THRESHOLD_ILS=500
GROUP_EXPIRY_DAYS=7
# Nearest-area suggestions beyond this distance return no area instead of a wrong city.
AREA_SUGGESTION_RADIUS_KM=25
# Optional: only used to identify standard-radius locations when coordinates exist.
STORE_LATITUDE=
STORE_LONGITUDE=
# Membership recovery by emailed code: resend | off (default) | memory (development/tests only).
RECOVERY_EMAIL_PROVIDER=off
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
RECOVERY_EMAIL_REPLY_TO=
# Card reservation through Cardcom (Low Profile JSON API v11, CreateTokenOnly + J2: card check, no charge) and
# charging after admin approval. Off unless CARDCOM_ENABLED=true. When enabled, every value below is required; a
# missing or invalid one disables reservations and charging (fail closed) while the rest of the service runs.
# Use Cardcom sandbox/test credentials until a live test is explicitly approved. Never commit real values.
CARDCOM_ENABLED=false
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
# 32 random bytes as 64 hex characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Seals Cardcom tokens at rest (AES-256-GCM). There is no fallback; rotating it makes stored tokens unreadable.
GROUP_DELIVERY_PAYMENT_ENCRYPTION_KEY=
# Storefront page that renders the Group Delivery section (its origin must be in STOREFRONT_ORIGINS).
CARDCOM_SUCCESS_URL=
# Optional; defaults to CARDCOM_SUCCESS_URL.
CARDCOM_ERROR_URL=
# Optional; defaults to APP_ORIGIN + /webhooks/cardcom/low-profile (it must be exactly that).
CARDCOM_WEBHOOK_URL=
# Minutes before an unfinished reservation expires (10-120, default 30).
CARDCOM_RESERVATION_TTL_MINUTES=30
# Shopify orders for charged card members (GraphQL Admin orderCreate / orderCreateManualPayment / tagsAdd / orderCancel).
# Dev Dashboard app in the same Shopify organization as the store, installed with the access scope write_orders
# (it includes read access to orders; nothing else is needed). Authentication: client credentials grant; the access
# token is obtained and refreshed in memory. Required to approve (charge) card groups. Server only; never commit values.
# SHOPIFY_ADMIN_ACCESS_TOKEN (static token) is not supported and is refused if set.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-10
# true creates Shopify test orders (sandbox/staging); default false.
SHOPIFY_ORDERS_TEST=false
# Transaction cancellation requests ("ביטול עסקה", storefront form -> POST /api/v1/cancellations; admin: /admin/cancellations).
# 32 random bytes as 64 hex characters, a DEDICATED key (never the payment key, SESSION_SECRET or any other secret;
# the service refuses a reused key). Encrypts Israeli ID numbers at rest (AES-256-GCM). Without it the form refuses
# requests (503) and shoppers are shown the other cancellation channels. Rotating it makes stored ID numbers unreadable.
CANCELLATION_ENCRYPTION_KEY=
# Days after a request is marked "הטיפול הסתיים" (completed) before its personal data, including the encrypted ID
# number, is permanently cleared (1-3650). Empty = nothing is ever deleted (the admin pages show a warning).
# There is no default on purpose: the merchant chooses this period after legal/accounting advice.
CANCELLATION_RETENTION_DAYS=
# Optional: internal address notified of each new request (reference, time and admin link only; never personal data).
# Sent through the same provider as recovery email (RECOVERY_EMAIL_PROVIDER=resend, RESEND_API_KEY, RECOVERY_EMAIL_FROM).
CANCELLATION_NOTIFY_EMAIL=

# Post-purchase feedback (Thank you page survey, /admin/feedback). Submissions are authenticated with the Shopify session
# token of the Fankee app's checkout UI extension, so SHOPIFY_CLIENT_ID and SHOPIFY_CLIENT_SECRET above must belong to the
# app that contains that extension. Without them the survey endpoint answers 503 and the Thank you page shows the
# failure message only (the order confirmation is never affected).
# The Thank you page holds the survey only: no Google review request (planned separately, after confirmed delivery).
