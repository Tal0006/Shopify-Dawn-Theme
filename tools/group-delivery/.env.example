PORT=4330
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:4330
STOREFRONT_ORIGINS=
TRUST_PROXY_HOPS=0
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
STANDARD_DELIVERY_RADIUS_KM=20
GROUP_THRESHOLD_ILS=500
GROUP_EXPIRY_DAYS=7
# Nearest-area suggestions beyond this distance return no area instead of a wrong city.
AREA_SUGGESTION_RADIUS_KM=25
# Optional: only used to identify standard-radius locations when coordinates exist.
STORE_LATITUDE=
STORE_LONGITUDE=
# Payments fail closed: "none" (default) refuses verification and new joins. "mock" is a development simulator
# that never moves money and also requires ALLOW_MOCK_PAYMENTS=true; never set it on the production service.
PAYMENT_PROVIDER=none
ALLOW_MOCK_PAYMENTS=
# Member payment-approval window (hours) after the merchant approves a group; fixed per group, 1-168.
PAYMENT_APPROVAL_HOURS=24
# Money moves only through authorize/capture unless explicitly allowed (never allowed in production).
PAYMENT_EXECUTION_POLICY=require_authorization
# Optional bearer secret (32+ chars) for POST /internal/payment-maintenance; leave empty to disable the route.
MAINTENANCE_TOKEN=
